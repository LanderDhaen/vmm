@page "/stations/edit/{StationId:guid}"
@using Rise.Client.Components.Location
@inject NavigationManager Navigation

<PageTitle>Meetstation bewerken</PageTitle>

@if (Model is null)
{
	<MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large"/>
}
else
{
	<MudCard>
		<MudForm Model="@Model" @ref="form" Validation="_validator.ValidateValue" ValidationDelay="0">
			<MudCardContent>
				<MudGrid>
					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Code</MudText>
						<MudTextField @bind-Value="Model.Code"
						              For="@(() => Model.Code)"
						              Counter="64"
						              MaxLength="64"
						              Immediate="true"
						              Variant="Variant.Outlined"
						              Placeholder="Code"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Installatie datum</MudText>
						<MudDatePicker @bind-Date="Model.InstalledAt"
						               For="@(() => Model.InstalledAt)"
						               DateFormat="dd/MM/yyyy"
						               Variant="Variant.Outlined"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Verwijderd op</MudText>
						<MudDatePicker @bind-Date="Model.RemovedAt"
						               For="@(() => Model.RemovedAt)"
						               DateFormat="dd/MM/yyyy"
						               Variant="Variant.Outlined"/>
					</MudItem>
				</MudGrid>
			</MudCardContent>
		</MudForm>

		<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
			<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@EditStationAsync">
				Opslaan
			</MudButton>

			<MudButton Href="/stations" Variant="Variant.Outlined" Color="Color.Primary">
				Annuleren
			</MudButton>
		</MudCardActions>
	</MudCard>
}
