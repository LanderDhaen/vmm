@using Rise.Shared.Projects
@using Rise.Client.Components.Projects;

<PageTitle>Project Details</PageTitle>

@if (ProjectsFromStation is null)
{
	<MudContainer Class="d-flex justify-center align-center">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	@* Desktop view *@

	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudTable T="ProjectDto.Index" Striped="true" Hover="true" Items="ProjectsFromStation" CustomHeader="true"
		          OnRowClick="@(args => NavigateToProject(args.Item!.Id))">
			<HeaderContent>
				<MudTHeadRow>
					<MudTh Class="mud-theme-primary">#</MudTh>
					<MudTh Class="mud-theme-primary">Naam</MudTh>
					<MudTh Class="mud-theme-primary">Startdatum</MudTh>
					<MudTh Class="mud-theme-primary">Einddatum</MudTh>
					<MudTh Class="mud-theme-primary">Status</MudTh>
					<MudTh Class="mud-theme-primary">Meetnet</MudTh>
					<MudTh Class="mud-theme-primary">Zone</MudTh>
				</MudTHeadRow>
			</HeaderContent>
			<RowTemplate>
				<MudTd DataLabel="#">@context.Code</MudTd>
				<MudTd DataLabel="Naam">@context.Name</MudTd>
				<MudTd DataLabel="Startdatum">@ProjectUtility.ToShortStartDate(context.StartDate)</MudTd>
				<MudTd DataLabel="Einddatum">@ProjectUtility.ToShortEndDate(context.EndDate)</MudTd>
				<MudTd DataLabel="Status">
					<ProjectStatusChip Status="@context.Status"/>
				</MudTd>
				<MudTd DataLabel="Locatie">@context.MeasurementNetwork</MudTd>
				<MudTd DataLabel="Gemeente">@context.Zone</MudTd>
			</RowTemplate>
		</MudTable>
	</MudHidden>

	@* Mobile view *@

	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<MudGrid Spacing="4">
			@foreach (var item in ProjectsFromStation)
			{
				<MudItem xs="12">
					<ProjectCard Project="item" />
				</MudItem>
			}
		</MudGrid>
	</MudHidden>
}
