@using Rise.Shared.Projects
@using Rise.Client.Components.Projects;

<PageTitle>Project Details</PageTitle>

@if (_projectsFromStation is null)
{
	<MudContainer Class="d-flex justify-center align-center">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	@* Desktop view *@

	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
			<MudTextField T="string"
			              InputType="InputType.Search"
			              Label="Zoek"
			              Class="m-0"
			              Variant="Variant.Outlined"
			              Adornment="Adornment.End"
			              AdornmentIcon="@Icons.Material.Filled.Search"
			              DebounceInterval="300"
			              OnDebounceIntervalElapsed="HandleIntervalElapsed"
			              @bind-Value="_searchTerm"
			              Margin="Margin.Dense"/>
			<MudButton Variant="Variant.Filled"
			           StartIcon="@Icons.Material.Filled.PlaylistAdd"
			           Size="Size.Small"
			           Color="Color.Primary"
			           Class="px-4">
				Project toevoegen
			</MudButton>
		</MudStack>

		<MudTable T="ProjectDto.Index" Striped="true" Hover="true" Items="_projectsFromStation" CustomHeader="true" OnRowClick="@(args => NavigateToProject(args.Item!.Id))">
			<HeaderContent>
				<MudTHeadRow>
					<MudTh Class="mud-theme-primary">#</MudTh>
					<MudTh Class="mud-theme-primary">Naam</MudTh>
					<MudTh Class="mud-theme-primary">Startdatum</MudTh>
					<MudTh Class="mud-theme-primary">Einddatum</MudTh>
					<MudTh Class="mud-theme-primary">Status</MudTh>
					<MudTh Class="mud-theme-primary">Meetnet</MudTh>
					<MudTh Class="mud-theme-primary">Zone</MudTh>
				</MudTHeadRow>
			</HeaderContent>
			<RowTemplate>
				<MudTd DataLabel="#">@context.Code</MudTd>
				<MudTd DataLabel="Naam">@context.Name</MudTd>
				<MudTd DataLabel="Startdatum">@context.StartDate</MudTd>
				<MudTd DataLabel="Einddatum">@context.EndDate</MudTd>
				<MudTd DataLabel="Status">
					<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(ProjectUtility.DefineStatusColor(context.Status))">
						@context.Status
					</MudChip>
				</MudTd>
				<MudTd DataLabel="Locatie">@context.MeasurementNetwork</MudTd>
				<MudTd DataLabel="Gemeente">@context.Zone</MudTd>
			</RowTemplate>
		</MudTable>
	</MudHidden>

	@* Mobile view *@

	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
			<MudTextField T="string"
			              InputType="InputType.Search"
			              Label="Zoek"
			              Class="m-0"
			              Variant="Variant.Outlined"
			              Adornment="Adornment.End"
			              AdornmentIcon="@Icons.Material.Filled.Search"
			              DebounceInterval="300"
			              OnDebounceIntervalElapsed="HandleIntervalElapsed"
			              @bind-Value="_searchTerm"
			              Margin="Margin.Dense"/>
			<MudIconButton Variant="Variant.Filled"
			               Icon="@Icons.Material.Filled.PlaylistAdd"
			               Size="Size.Small"
			               Color="Color.Primary"/>
		</MudStack>

		<MudGrid Spacing="4">
			@foreach (var item in _projectsFromStation)
			{
				<MudItem xs="12">
					<ProjectCard Project="item" />
				</MudItem>
			}
		</MudGrid>
	</MudHidden>
}
