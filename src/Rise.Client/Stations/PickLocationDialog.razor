@inject IJSRuntime JS

<MudDialog>
	<DialogContent>
		<div id="pick-map" style="height:450px;width:100%"></div>

		<MudText Typo="Typo.caption" Class="mt-2">
			Klik op de kaart om een locatie te kiezen.
		</MudText>

		@if (_picked is not null)
		{
			<MudText Typo="Typo.caption" Class="mt-1">
				Gekozen coords: X=@_picked.X, Y=@_picked.Y
			</MudText>
		}
	</DialogContent>

	<DialogActions>
		<MudButton OnClick="Cancel">Annuleer</MudButton>
		<MudButton Color="Color.Primary"
		           Variant="Variant.Filled"
		           Disabled="@(_picked is null)"
		           OnClick="Confirm">
			Bevestig locatie
		</MudButton>
	</DialogActions>
</MudDialog>