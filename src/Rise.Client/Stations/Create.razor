@page "/stations/create"
@using Rise.Client.Components.Stations

<PageTitle>Meetstation toevoegen</PageTitle>

<MudCard Class="my-4">
	<MudForm Model="@Model" @ref="_form" Validation="_validator.ValidateValue" ValidationDelay="0">
		<CreateStationForm Model="Model"></CreateStationForm>
	</MudForm>
	<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateProjectAsync">Opslaan
		</MudButton>
		<MudButton Href="/stations" Variant="Variant.Outlined" Color="Color.Primary">Annuleren
		</MudButton>
	</MudCardActions>
</MudCard>
