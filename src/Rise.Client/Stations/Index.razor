@page "/stations"
@using Rise.Client.Components
@using Rise.Shared.Stations

<PageTitle>Stations</PageTitle>

<MudPaper Class="projects-grid-wrapper" Elevation="2" Rounded="true">
	<MudDataGrid T="MeasurementStationDto.Index"
	             ServerData="GetStationsAsync"
	             RowsPerPage="10"
	             Bordered="true"
	             Striped="true"
	             Hover="true"
	             Dense="false"
	             Elevation="0">

		<ToolBarContent>
			<ToolBar/>
		</ToolBarContent>

		<Columns>
			<PropertyColumn Property="x => x.Code" Title="#"/>
			<PropertyColumn Property="x => x.Status" Title="Status"/>
			<PropertyColumn Property="x => x.InstalledAt" Title="Geïnstalleerd"/>
			<PropertyColumn Property="x => x.RemovedAt" Title="Verwijderd"/>
			<PropertyColumn Property="x => x.Location.Name" Title="Locatie"/>
			<PropertyColumn Property="@(x => $"{x.Location.Coordinate.X} - {x.Location.Coordinate.Y}")"
			                Title="Coördinaten"/>
			<PropertyColumn Property="@(x => $"{x.Location.Address.AddressLine1}, {x.Location.Address.AddressLine2}")"
			                Title="Adres"/>
			<PropertyColumn Property="@(x => $"{x.Location.Address.City}, {x.Location.Address.PostalCode}")"
			                Title="Gemeente"/>
			<PropertyColumn Property="x => x.Location.Address.CountryIso" Title="Land"/>
			<PropertyColumn Property="x => x.ProjectName" Title="Project"/>
			<PropertyColumn Property="x => x.ProjectCode" Title="Projectcode"/>
		</Columns>

		<PagerContent>
			<Pagination T="MeasurementStationDto.Index"/>
		</PagerContent>
	</MudDataGrid>
</MudPaper>