@page "/stations"
@using Rise.Client.Components
@using Rise.Shared.Stations

<PageTitle>Stations</PageTitle>

	@* Desktop view *@
	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
			<MudTextField T="string"
			              Label="Zoek"
			              Class="m-0"
			              Variant="Variant.Outlined"
			              Adornment="Adornment.End"
			              AdornmentIcon="@Icons.Material.Filled.Search"
			              DebounceInterval="300"
			              OnDebounceIntervalElapsed="HandleDesktopIntervalElapsed"
			              @bind-Value="_searchTerm"
			              FullWidth="true"
			              Margin="Margin.Dense"/>
			<MudButton Variant="Variant.Filled"
			           Size="Size.Small"
			           StartIcon="@Icons.Material.Filled.FilterAlt"
			           Color="Color.Primary"
			           Class="px-4"
			           OnClick="@ToggleFiltersDrawer">
				Filteren
			</MudButton>
			<MudButton Variant="Variant.Filled"
			           StartIcon="@Icons.Material.Filled.Add"
			           Size="Size.Small"
			           Color="Color.Primary"
			           Class="px-4"
			           OnClick="@NavigateToCreate">
				Meetstation
			</MudButton>
		</MudStack>

		<MudDataGrid T="MeasurementStationDto.Index"
		             ServerData="GetStationsAsync"
		             @ref="_grid"
		             RowsPerPage="10"
		             Striped="true"
		             Hover="true"
		             SortMode="SortMode.Single"
		             RowClick="@(args => NavigateToStation(args.Item.Id))">

			<Columns>
				<PropertyColumn Property="x => x.Code" InitialDirection="SortDirection.Ascending" Title="#" HeaderClass="mud-theme-primary"/>
	    		<PropertyColumn Property="x => x.InstalledAt" Title="Geïnstalleerd" HeaderClass="mud-theme-primary" Format="dd-MM-yyyy HH:mm" />
	    		<PropertyColumn Property="x => x.RemovedAt" Title="Verwijderd" HeaderClass="mud-theme-primary" Format="dd-MM-yyyy HH:mm" />
				<PropertyColumn Property="x => x.Location" Title="Locatie" HeaderClass="mud-theme-primary"/>
				<PropertyColumn Property="x => x.City" Title="Gemeente" HeaderClass="mud-theme-primary"/>
				<PropertyColumn Property="x => x.ProjectsCount" Title="Projecten" HeaderClass="mud-theme-primary"/>
			</Columns>

			<PagerContent>
				<Pagination T="MeasurementStationDto.Index"/>
			</PagerContent>

		</MudDataGrid>
	</MudHidden>

	@* Mobile view *@
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
			<MudTextField T="string"
			              Label="Zoek"
			              Class="m-0"
			              Variant="Variant.Outlined"
			              Adornment="Adornment.End"
			              AdornmentIcon="@Icons.Material.Filled.Search"
			              DebounceInterval="300" 
			              OnDebounceIntervalElapsed="HandleMobileIntervalElapsed" 
			              @bind-Value="_searchTerm"
			              FullWidth="true"
			              Margin="Margin.Dense"/>

			<MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha"
			               Color="Color.Primary"
			               Size="Size.Small"
			               OnClick="@ToggleSortingDrawer"/>

	        <MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
	                       Color="Color.Primary"
	                       Size="Size.Small"
	                       OnClick="@ToggleFiltersDrawer"/>

			<MudIconButton Icon="@Icons.Material.Filled.Add"
			               Color="Color.Primary"
			               Size="Size.Small"
			               OnClick="@NavigateToCreate"/>
		</MudStack>

		<MudGrid Spacing="4">
			@if (_mobileItems is null)
			{
				<MudItem xs="12">
					<div>
						<MudProgressCircular Indeterminate="true"/>
					</div>
				</MudItem>
			}
			else if (!_mobileItems.Any())
			{
				<MudItem xs="12">
					<MudText>Geen Meetstations</MudText>
				</MudItem>
			}
			else
			{
				@foreach (var item in _mobileItems)
				{
					<MudItem xs="12">
						<MudCard Elevation="2" Class="rounded-lg" @onclick="() => NavigateToStation(item.Id)">
							<MudCardHeader>
								<CardHeaderContent>
									<MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>@item.Code</b></MudText>
								</CardHeaderContent>
							</MudCardHeader>
							<MudCardContent Class="pt-0">
								<MudText Typo="Typo.subtitle1"><b>Geïnstalleerd:</b> @(item.InstalledAt is DateTime i ? i.ToString("dd-MM-yyyy HH:mm") : string.Empty)</MudText>
				              <MudText Typo="Typo.subtitle1"><b>Verwijderd:</b> @(item.RemovedAt is DateTime r ? r.ToString("dd-MM-yyyy HH:mm") : string.Empty)</MudText>
								<MudText Typo="Typo.subtitle1"><b>Gemeente:</b> @item.City</MudText>
								<MudText Typo="Typo.subtitle1"><b>Projecten:</b> @item.ProjectsCount</MudText>
							</MudCardContent>
						</MudCard>
					</MudItem>
				}
			}
		</MudGrid>
	</MudHidden>


@* Mobile sort drawer *@
@if (_mobileSortOptionsOpen)
{
	<MudDrawer Anchor="Anchor.Bottom"
	           Variant="DrawerVariant.Temporary"
	           Elevation="8"
	           @bind-Open="_mobileSortOptionsOpen"
	           Class="p-4 rounded-lg">
		<MudText Typo="Typo.h6">Sorteren</MudText>
		<MudStack Spacing="4">
			<MudDivider/>
			@foreach (var column in SortColumns)
			{
				<MudStack Row="true" AlignItems="AlignItems.Center">
					<MudText>@column.Label</MudText>
					<MudSpacer/>
					<MudButton
						Variant="@(_activeSorting == column.Value && !_activeSortingDesc ? Variant.Filled : Variant.Outlined)"
						Color="@(_activeSorting == column.Value && !_activeSortingDesc ? Color.Primary : Color.Default)"
						Size="Size.Small"
						OnClick="@(() => SortMobileAsync(column.Value, false))">
						Oplopend
					</MudButton>
					<MudButton
						Variant="@(_activeSorting == column.Value && _activeSortingDesc ? Variant.Filled : Variant.Outlined)"
						Color="@(_activeSorting == column.Value && _activeSortingDesc ? Color.Primary : Color.Default)"
						Size="Size.Small"
						OnClick="@(() => SortMobileAsync(column.Value, true))">
						Aflopend
					</MudButton>
				</MudStack>
			}
			<MudDivider/>
			<MudButton Variant="Variant.Text"
			           Color="Color.Primary"
			           OnClick="@ToggleSortingDrawer">
				Sluiten
			</MudButton>
		</MudStack>
	</MudDrawer>
}

@* FILTER DRAWER (adaptive anchor: right on desktop, bottom on xs) *@
@if (_filterOptionsOpen)
{
	<MudDrawer Anchor="@_filterDrawerAnchor"
	           Variant="DrawerVariant.Temporary"
	           Elevation="8"
	           @bind-Open="_filterOptionsOpen"
	           Class="@GetFilterDrawerClass()">
		<MudText Typo="Typo.h6" Color="Color.Primary">Filteren</MudText>

		<MudStack Spacing="3" Class="mt-2">
			<MudDivider/>

			<MudDatePicker T="DateTime?" Label="Installatiedatum" Date="_filterInstalledAt"
			              DateChanged="@(async val => { _filterInstalledAt = val; await ApplyOrReloadOnChangeAsync(); })"
			              Clearable="true" PickerVariant="PickerVariant.Dialog" />

			<MudDatePicker T="DateTime?" Label="Verwijderd op" Date="_filterRemovedAt"
			              DateChanged="@(async val => { _filterRemovedAt = val; await ApplyOrReloadOnChangeAsync(); })"
                    Clearable="true" PickerVariant="PickerVariant.Dialog" />

			<MudSelect T="string" Label="Locatie" Value="_filterLocation"
			           ValueChanged="@(async val => { _filterLocation = val; await ApplyOrReloadOnChangeAsync(); })"
			           Dense="true" Clearable="true" Placeholder="Selecteer..." OnOpen="HandleLocationSelectOpen">
				@if (_locations is null)
				{
					<MudSelectItem T="string" Disabled="true">Laden...</MudSelectItem>
				}
				else
				{
					@foreach (var z in _locations)
					{
						<MudSelectItem T="string" Value="@z">@z</MudSelectItem>
					}
				}
			</MudSelect>

			<MudSelect T="string" Label="Gemeente" Value="_filterCity"
			           ValueChanged="@(async val => { _filterCity = val; await ApplyOrReloadOnChangeAsync(); })"
			           Dense="true" Clearable="true" Placeholder="Selecteer..." OnOpen="HandleCitySelectOpen">
				@if (_cities is null)
				{
					<MudSelectItem T="string" Disabled="true">Laden...</MudSelectItem>
				}
				else
				{
					@foreach (var m in _cities)
					{
						<MudSelectItem T="string" Value="@m">@m</MudSelectItem>
					}
				}
			</MudSelect>

			<MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="pt-2">
				<MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@ClearFilters">Wissen</MudButton>
			</MudStack>
		</MudStack>
	</MudDrawer>
}