@using Rise.Shared.Stations
<PageTitle>Station Details</PageTitle>

@if (_measurementStation is null)
{
	<MudContainer Class="d-flex justify-center align-center">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudTimeline>
		@{
			var histories = _measurementStation.MeasurementStationHistories;

			for (var i = 0; i < histories.Count - 1; i++)
			{
				var curr = histories[i];
				var prev = histories[i + 1];  

				if (!prev.Location.Equals(curr.Location))
				{
					<MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
						<ItemOpposite>
							<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@HistoryUtility.ToLongValidFrom(curr.ValidFrom)</MudChip>
						</ItemOpposite>
						<ItemContent>
							<MudText Typo="Typo.h6">Meetstation verplaatst</MudText>
							<MudText>
								van <b>@prev.Location @prev.City</b> naar <b>@curr.Location @curr.City</b>
							</MudText>
						</ItemContent>
					</MudTimelineItem>
				}

				if (!prev.InstalledAt.Equals(curr.InstalledAt))
				{
					<MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
						<ItemOpposite>
							<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@HistoryUtility.ToLongValidFrom(curr.ValidFrom)</MudChip>
						</ItemOpposite>
						<ItemContent>
							<MudText Typo="Typo.h6">Installatiedatum aangepast</MudText>
							<MudText>
								van <b>@StationUtility.ToShortInstalledAt(prev.InstalledAt)</b> naar <b>@StationUtility.ToShortInstalledAt(curr.InstalledAt)</b>
							</MudText>
						</ItemContent>
					</MudTimelineItem>
				}

				if (!prev.RemovedAt.Equals(curr.RemovedAt))
				{
					<MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
						<ItemOpposite>
							<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@HistoryUtility.ToLongValidFrom(curr.ValidFrom)</MudChip>
						</ItemOpposite>
						<ItemContent>
							<MudText Typo="Typo.h6">Verwijderingsdatum aangepast</MudText>
							<MudText>
								van <b>@StationUtility.ToShortRemovedAt(prev.RemovedAt)</b> naar <b>@StationUtility.ToShortRemovedAt(curr.RemovedAt)</b>
							</MudText>
						</ItemContent>
					</MudTimelineItem>
				}
			}
		}
	</MudTimeline>
}