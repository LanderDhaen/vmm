@using Rise.Shared.Stations
<PageTitle>Station Details</PageTitle>

@if (_modifications is null)
{
	<MudContainer Class="d-flex justify-center align-center">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
<MudTimeline>
    @{
        
        // Comparing history entries

        foreach (var modification in _modifications)
        {
            if (modification.MeasurementStationModificationType == MeasurementStationModificationType.LocationChanged)
            {
                <MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
                    <ItemOpposite>
	                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@modification.ModifiedAt</MudChip>
                    </ItemOpposite>
                    <ItemContent>
                        <MudText Typo="Typo.h6">Meetstation verplaatst</MudText>
                        <MudText>
                            van <b>@modification.PreviousValue</b> naar <b>@modification.CurrentValue</b>
                        </MudText>
                    </ItemContent>
                </MudTimelineItem>
            }

            if (modification.MeasurementStationModificationType == MeasurementStationModificationType.InstalledAtChanged)
            {
                <MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
                    <ItemOpposite>
	                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@modification.ModifiedAt</MudChip>
                    </ItemOpposite>
                    <ItemContent>
                        <MudText Typo="Typo.h6">Installatiedatum aangepast</MudText>
                        <MudText>
                            van <b>@modification.PreviousValue</b> naar <b>@modification.CurrentValue</b>
                        </MudText>
                    </ItemContent>
                </MudTimelineItem>
            }

            if (modification.MeasurementStationModificationType == MeasurementStationModificationType.RemovedAtChanged)
            {
                <MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
                    <ItemOpposite>
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@modification.ModifiedAt</MudChip>
                    </ItemOpposite>
                    <ItemContent>
                        <MudText Typo="Typo.h6">Verwijderingsdatum aangepast</MudText>
                        <MudText>
                            van <b>@modification.PreviousValue</b> naar <b>@modification.CurrentValue</b>
                        </MudText>
                    </ItemContent>
                </MudTimelineItem>
            }
        }
    }
</MudTimeline>

}