@using Rise.Client.Components
<PageTitle>Station Details</PageTitle>

@if (_modifications is null)
{
	<MudContainer Class="d-flex justify-center align-center">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudBreakpointProvider OnBreakpointChanged="@OnBreakPointChange">
		<MudTimeline TimelinePosition="_timelinePosition" Class="mr-20 m-xs-0">
			@{
				foreach (var modification in _modifications) {
					<TimeLineItem Title="@(DefineTitle(modification.MeasurementStationModificationType))"
					              ModifiedAt="modification.ModifiedAt"
					              CurrentValue=@modification.CurrentValue
					              PreviousValue="@modification.PreviousValue"/>
				}
			}
		</MudTimeline>
	</MudBreakpointProvider>
}