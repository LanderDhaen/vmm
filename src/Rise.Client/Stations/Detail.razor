@page "/stations/{StationId:guid}"
@using Rise.Client.Components
@using Rise.Shared.Projects
@inject NavigationManager Navigation

<PageTitle>Station Details</PageTitle>

@if (_station is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<!-- ===== Desktop ===== -->

	<!-- ===== Mobile ===== -->
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<ArrowHeader Title="Meetstation" OnBack="NavigateToStations"/>
	</MudHidden>

	<div class="d-flex justify-space-between m-2 align-center" role="tablist" aria-label="Station tabs">
		<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(0)">
			@_tabs[0]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(1)">
			@_tabs[1]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 2 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(2)">
			@_tabs[2]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 3 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(3)">
			@_tabs[3]
		</MudText>
	</div>

	@switch (_selectedTab)
	{
		case 0:
			<MudPaper Class="p-4">
				<div class="d-flex align-center m-2">
					<MudText Class="pr-2" Typo="Typo.h5">@_station.Code</MudText>
					<MudIconButton Icon="@Icons.Material.Filled.Edit"
					               Color="Color.Primary"
					               Href="@($"/stations/edit/{_station.Id}")"
					               Title="Bewerken"/>
				</div>

				<MudGrid Class="p-2">

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Geïnstalleerd</MudText>
						<MudPaper Class="p-2">@FormatDate(_station.InstalledAt)</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Verwijderd</MudText>
						<MudPaper Class="p-2">@FormatDate(_station.RemovedAt)</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Locatie</MudText>
						<MudPaper Class="p-2">@_station.Location</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Gemeente</MudText>
						<MudPaper Class="p-2">@_station.City</MudPaper>
					</MudItem>
				</MudGrid>
			</MudPaper>
			break;

		case 1:
			<MudText Typo="Typo.body1" Class="m-4">[Lijst van apparaten]</MudText>
			break;

		case 2:
			<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
				<MudSelect T="Guid" Label="Projecten toevoegen" MultiSelection="true"
				           @bind-SelectedValues="Model.ProjectIds" Variant="Variant.Outlined"
				           Margin="Margin.Dense"
				           ToStringFunc="id => _allProjects.FirstOrDefault(x => x.Id == id)?.Code ?? string.Empty">
					<ChildContent>
						<MudSelectItem T="Guid">
							<div class="p-2">
								<MudButton Variant="Variant.Text" Color="Color.Primary"
								           StartIcon="@Icons.Material.Filled.Add" OnClick="@NavigateToCreateProject">Nieuw
									project toevoegen
								</MudButton>
							</div>
						</MudSelectItem>
						@foreach (var project in _allProjects)
						{
							if (project.Status == Status.Afgesloten)
							{
								<MudSelectItem T="Guid" Value="@project.Id" Disabled="true">@project.Code</MudSelectItem>
								<MudSelectItem T="Guid" Value="@project.Id" Style="display:none"></MudSelectItem>
							}
							else
							{
								<MudSelectItem T="Guid" Value="@project.Id">@project.Code</MudSelectItem>
							}
						}
					</ChildContent>
				</MudSelect>

				<MudButton Variant="Variant.Filled"
				           StartIcon="@Icons.Material.Filled.Add"
				           Size="Size.Small"
				           Color="Color.Primary"
				           Class="px-4"
				           OnClick="@UpdateProjects"
				>
					Project toevoegen
				</MudButton>
			</MudStack>
			<MudPaper Class="projects-grid-wrapper" Elevation="2" Rounded="true">
				<MudDataGrid T="ProjectDto.Index"
				             @ref="_projectsGrid"
				             ServerData="GetProjectsGridAsync"
				             RowsPerPage="10"
				             Bordered="true"
				             Striped="true"
				             Hover="true"
				             Dense="false"
				             Elevation="0"
				             RowClick="OnProjectRowClick">
					<Columns>
						<PropertyColumn Property="x => x.Code" Title="#" Sortable="false" Filterable="false"
						                Groupable="false"/>
						<PropertyColumn Property="x => x.Name" Title="Naam" Sortable="false" Filterable="false"
						                Groupable="false"/>
						<PropertyColumn Property="x => x.StartDate" Title="Startdatum" Sortable="false"
						                Filterable="false" Groupable="false"/>
						<PropertyColumn Property="x => x.EndDate" Title="Einddatum" Sortable="false" Filterable="false"
						                Groupable="false"/>
						<PropertyColumn Property="x => x.MeasurementNetwork" Title="Meetnet" Sortable="false"
						                Filterable="false" Groupable="false"/>
						<PropertyColumn Property="x => x.Zone" Title="Zone" Sortable="false" Filterable="false"
						                Groupable="false"/>
					</Columns>

					<PagerContent>
						<Pagination T="ProjectDto.Index"/>
					</PagerContent>
				</MudDataGrid>
			</MudPaper>
			break;

		case 3:
			<MudText Typo="Typo.body1" Class="m-4">[Historiek van dit meetstation]</MudText>
			break;
	}
}
