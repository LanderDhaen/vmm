@page "/stations/{StationId:guid}"
@inject NavigationManager Navigation

<PageTitle>Station Details</PageTitle>

@if (_station is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{	
	
	@* Tabs *@
	
	<MudStack Row="true" Justify="Justify.FlexStart" Spacing="8">
		<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(0)">
			@_tabs[0]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(1)">
			@_tabs[1]
		</MudText>
	</MudStack>
	
	<MudGrid Spacing="4" Class="mt-4">
	
		@* Details *@
		
		<MudItem xs="12" md="6">
			<MudCard Elevation="2" Class="rounded-lg">
				<MudCardHeader>
					<CardHeaderContent>
						<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
							<MudText Typo="Typo.h6" Color="Color.Primary">@_station.Code</MudText>
							<MudButton Variant="Variant.Text"
							           StartIcon="@Icons.Material.Filled.Edit"
							           Size="Size.Small"
							           Color="Color.Primary"
							           Class="px-4">
								Aanpassen
							</MudButton>
						</MudStack>
					</CardHeaderContent>
				</MudCardHeader>
				<MudCardContent>
					<MudText><b>Geïnstalleerd: </b>@(StationUtility.FormatInstalledAt(_station.InstalledAt))</MudText>
					<MudText><b>Verwijderd: </b>@(StationUtility.FormatRemovedAt(_station.RemovedAt))</MudText>
				</MudCardContent>
			</MudCard>
		</MudItem>
		
		@* Location *@
		
		<MudItem xs="12" md="6">
			<MudCard Elevation="2" Class="rounded-lg">
				<MudCardHeader>
					<CardHeaderContent>
						<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
							<MudText Typo="Typo.h6" Color="Color.Primary">@_station.Location.Name</MudText>
							<MudButton Variant="Variant.Text"
							           StartIcon="@Icons.Material.Filled.MyLocation"
							           Size="Size.Small"
							           Color="Color.Primary"
							           Class="px-4">
								Verplaatsen
							</MudButton>
						</MudStack>
					</CardHeaderContent>
				</MudCardHeader>
				<MudCardContent>
					<MudText><b>Adresregel 1: </b>@_station.Location.AddressLine2</MudText>
					<MudText><b>Adresregel 2: </b>@_station.Location.AddressLine2</MudText>
					<MudStack Row="true" Justify="Justify.FlexStart" Spacing="8">
						<MudText><b>Stad: </b>@_station.Location.City</MudText>
						<MudText><b>Postcode: </b>@_station.Location.PostalCode</MudText>
						<MudText><b>Land: </b>@_station.Location.Country</MudText>
					</MudStack>
				</MudCardContent>
			</MudCard>
		</MudItem>
		
		@* Projects *@
		
		<MudItem xs="12">
			
			<Projects StationId="_station.Id" />
			
		</MudItem>
		
	</MudGrid>
}
