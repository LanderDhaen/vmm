@page "/stations/{StationId:guid}"
@using Rise.Client.Components.Locations
@inject NavigationManager Navigation

<PageTitle>Station Details</PageTitle>

@if (_station is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	@* Tabs *@

	<MudStack Class="pt-2" Row="true" Justify="Justify.FlexStart" Spacing="6">
		<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
		         @onclick="() =>  SetTabAsync(0)">
			@_tabs[0]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
		         @onclick="() => SetTabAsync(1)">
			@_tabs[1]
		</MudText>
	</MudStack>

	@switch (_selectedTab)
	{
		case 0:
			<MudGrid Spacing="4" Class="mt-2">
				@* Details *@
				<MudItem xs="12" md="6" Class="d-flex">
					<MudCard Elevation="2" Class="rounded-lg flex-grow-1">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6" Color="Color.Primary">@_station.Code</MudText>
									<MudTooltip Text="Meetstation bewerken" Delay="600">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.Edit"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@OpenEditStationDialogAsync">
											Aanpassen
										</MudButton>
									</MudTooltip>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudText><b>Geïnstalleerd:</b> @(StationUtility.ToLongInstalledAt(_station.InstalledAt))
							</MudText>
							<MudText><b>Verwijderd:</b> @(StationUtility.ToLongRemovedAt(_station.RemovedAt))</MudText>
							<MudText><b>Projecten:</b> @_station.ProjectsCount</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Location *@
				<MudItem xs="12" md="6">
					<LocationCard Location="_station.Location" OnClick="@OpenUpdateLocationDialogAsync"/>
				</MudItem>

				@* MaintObj table *@
				<MudItem xs="12">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">Onderhoudsobjecten
									</MudText>
									<MudTooltip Text="Onderhoudsobjecten toevoegen" Delay="600"
									            Placement="Placement.Top">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.PlaylistAdd"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@OpenMaintObjectsListDialogAsync">
											Toevoegen
										</MudButton>
									</MudTooltip>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MaintObjects StationId="_station.Id" MaintObjectsFromStation="_maintObjectsFromStation"/>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Projects table *@
				<MudItem xs="12">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">Projecten
									</MudText>
									<MudTooltip Text="Lijst bewerken" Delay="600" Placement="Placement.Top">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.PlaylistAdd"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@OpenDialogAsync">
											Aanpassen
										</MudButton>
									</MudTooltip>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<Projects StationId="_station.Id" ProjectsFromStation="_projectsFromStation"/>
						</MudCardContent>
					</MudCard>
				</MudItem>
			</MudGrid>
			break;

		case 1:
			<History MeasurementStationId="StationId"/>
			break;
	}
}
