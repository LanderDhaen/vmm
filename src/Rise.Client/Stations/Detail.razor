@page "/stations/{StationId:guid}"
@inject NavigationManager Navigation

<PageTitle>Station Details</PageTitle>

@if (_station is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<!-- ===== Desktop ===== -->
	<div class="d-flex justify-space-between py-2 align-center" role="tablist" aria-label="Station tabs">
		<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(0)">
			@_tabs[0]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(1)">
			@_tabs[1]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 2 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(2)">
			@_tabs[2]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 3 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(3)">
			@_tabs[3]
		</MudText>
	</div>

	@switch (_selectedTab)
	{
		case 0:
			<MudPaper Class="pa-4">
				<div class="d-flex align-center ma-2">
					<MudText Class="pr-2" Typo="Typo.h5">@_station.Code</MudText>
					<MudTooltip Delay="400" Placement="Placement.Right" Text="Meetstation bewerken">
						<MudIconButton Icon="@Icons.Material.Filled.Edit"
						               Color="Color.Primary"
						               Href="@($"/stations/edit/{_station.Id}")"/>
					</MudTooltip>
				</div>

				<MudGrid Class="pa-2">

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Geïnstalleerd</MudText>
						<MudPaper Class="pa-2">@FormatDate(_station.InstalledAt)</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Verwijderd</MudText>
						<MudPaper Class="pa-2">@FormatDate(_station.RemovedAt)</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Locatie</MudText>
						<MudPaper Class="pa-2">@_station.Location</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Gemeente</MudText>
						<MudPaper Class="pa-2">@_station.City</MudPaper>
					</MudItem>
				</MudGrid>
			</MudPaper>
			break;

		case 1:
			<MudText Typo="Typo.body1">[Lijst van apparaten]</MudText>
			break;

		case 2:
			<Projects StationId="StationId" TabChanged="OnTabChange"/>
			break;

		case 3:
			<History MeasurementStationId="StationId"/>
			break;
	}
}
