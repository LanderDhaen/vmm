@page "/stations/{StationId:guid}"
@using Rise.Client.Components
@using Rise.Shared.Stations
@inject NavigationManager Navigation

<PageTitle>Station Details</PageTitle>

@if (_station is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
	</MudContainer>
}
else
{
	// ===== Desktop =====
	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudBreadcrumbs Items="_items" Class="p-0 m-2 gutter-2">
			<SeparatorTemplate>
				<MudIcon Icon="@Icons.Material.Filled.ArrowRight" Size="Size.Small" />
			</SeparatorTemplate>
		</MudBreadcrumbs>
	</MudHidden>

	// ===== Mobile =====
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<ArrowHeader Title="Meetstation" OnBack="NavigateToStations" />
	</MudHidden>

	// ===== Tabs =====
	<div class="d-flex justify-space-between m-2 align-center" role="tablist" aria-label="Station tabs">
		<MudText
			Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
			@onclick="() => SetTab(0)">
			@_tabs[0]
		</MudText>

		<MudText
			Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
			@onclick="() => SetTab(1)">
			@_tabs[1]
		</MudText>

		<MudText
			Class="@($"tab-item {(_selectedTab == 2 ? "active" : "")}")"
			@onclick="() => SetTab(2)">
			@_tabs[2]
		</MudText>

		<MudDivider Vertical="true" FlexItem="true" />
		<MudIcon Icon="@Icons.Material.Outlined.MoreHoriz"></MudIcon>
	</div>

	@switch (_selectedTab)
	{
		case 0:
			// ===== Info Tab =====
			<div class="d-flex align-center m-2">
				<MudText Class="pr-2" Typo="Typo.h5">@_station.Code</MudText>
				<MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"></MudIcon>
			</div>

			<MudGrid Class="p-2">
				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Status</MudText>
					<MudPaper Class="p-2">@FormatStatus(_station.Status)</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Geïnstalleerd</MudText>
					<MudPaper Class="p-2">@FormatDate(_station.InstalledAt)</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Verwijderd</MudText>
					<MudPaper Class="p-2">@FormatDate(_station.RemovedAt)</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Locatie</MudText>
					<MudPaper Class="p-2">@_station.Location</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Gemeente</MudText>
					<MudPaper Class="p-2">@_station.City</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2"># Projecten</MudText>
					<MudPaper Class="p-2">@_station.ProjectsCount</MudPaper>
				</MudItem>
			</MudGrid>
			break;

		case 1:
			<MudText Typo="Typo.body1" Class="m-4">[Lijst van apparaten]</MudText>
			break;

		case 2:
			<MudText Typo="Typo.body1" Class="m-4">[Historiek van dit meetstation]</MudText>
			break;
	}
}
