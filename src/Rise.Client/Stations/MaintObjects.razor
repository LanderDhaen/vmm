@using Rise.Shared.MaintObjects

<PageTitle>MaintObjects</PageTitle>

@if (_maintObjsFromStation is null)
{
    <MudContainer Class="d-flex justify-center align-center">
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
    </MudContainer>
}
else
{
    @* Desktop view *@
    <MudHidden Breakpoint="Breakpoint.Xs">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
            <MudSelect T="Guid"
                       Label="Apparaten toevoegen"
                       MultiSelection="true"
                       SelectedValues="Model.MaintObjIds"
                       SelectedValuesChanged="@(vals => Model.MaintObjIds = vals.ToList())"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       ToStringFunc="id => _allMaintObjs!.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty"
                       MultiSelectionTextFunc="GetSelectedMaintObjText">

                @foreach (var mo in _allMaintObjs!)
                {
                    <MudSelectItem T="Guid" Value="@mo.Id">
                        <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
                            @mo.Name - @mo.SerialNumber
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.PlaylistAdd"
                       Size="Size.Small"
                       Color="Color.Primary"
                       Class="px-4"
                       OnClick="@UpdateMaintObjs">
                Lijst bijwerken
            </MudButton>
        </MudStack>

        <MudTable T="MaintObjDto.Index"
                  Items="_maintObjsFromStation"
                  CustomHeader="true">
            <HeaderContent>
                <MudTHeadRow>
                    <MudTh Class="mud-theme-primary">Naam</MudTh>
                    <MudTh Class="mud-theme-primary">Serienummer</MudTh>
                    <MudTh Class="mud-theme-primary">Type</MudTh>
                    <MudTh Class="mud-theme-primary">Status</MudTh>
                    <MudTh Class="mud-theme-primary">Locatie</MudTh>
                </MudTHeadRow>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Naam">@context.Name</MudTd>
                <MudTd DataLabel="Serienummer">@context.SerialNumber</MudTd>
                <MudTd DataLabel="Type">@context.MaintObjType</MudTd>

                <MudTd DataLabel="Status">
                    <MudChip T="string"
                             Variant="Variant.Outlined"
                             Color="@GetStatusColor(context.MaintObjStatus)"
                             Size="Size.Small">
                        @context.MaintObjStatus
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Locatie">@context.Location</MudTd>
            </RowTemplate>
        </MudTable>
    </MudHidden>

    @* Mobile view *@
    <MudHidden Breakpoint="Breakpoint.SmAndUp">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
            <MudSelect T="Guid"
                       Label="Apparaten toevoegen"
                       MultiSelection="true"
                       SelectedValues="Model.MaintObjIds"
                       SelectedValuesChanged="@(vals => Model.MaintObjIds = vals.ToList())"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       ToStringFunc="id => _allMaintObjs!.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty"
                       MultiSelectionTextFunc="GetSelectedMaintObjText">

                @foreach (var mo in _allMaintObjs!)
                {
                    <MudSelectItem T="Guid" Value="@mo.Id">
                        <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
                            @mo.Name
                            <MudBadge Dot="true" Color="@GetStatusColor(mo.MaintObjStatus)" />
                        </MudStack>
                    </MudSelectItem>
                }
            </MudSelect>

            <MudIconButton Variant="Variant.Filled"
                           Icon="@Icons.Material.Filled.PlaylistAdd"
                           Size="Size.Small"
                           Color="Color.Primary"
                           OnClick="@UpdateMaintObjs" />
        </MudStack>

        <MudGrid Spacing="6">
            @foreach (var mo in _maintObjsFromStation)
            {
                <MudItem xs="12">
                    <MudCard Elevation="2" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">@mo.Name</MudText>
                                    <MudText Typo="Typo.caption">@mo.SerialNumber</MudText>
                                </MudStack>
                            </CardHeaderContent>

                            <CardHeaderActions>
                                <MudIcon Icon="@Icons.Material.Filled.Circle"
                                         Color="@GetStatusColor(mo.MaintObjStatus)"
                                         Size="Size.Small" />
                            </CardHeaderActions>
                        </MudCardHeader>

                        <MudCardContent Class="d-flex flex-column gap-1">
                            <MudText Typo="Typo.caption"><b>Type:</b> @mo.MaintObjType</MudText>
                            <MudText Typo="Typo.caption"><b>Status:</b> @mo.MaintObjStatus</MudText>
                            <MudText Typo="Typo.caption"><b>Locatie:</b> @mo.Location</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </MudHidden>
}
