@page "/maintobjects/create"
@using Rise.Client.Components.MaintObjects

<MudCard>
	<MudForm Model="@Model" @ref="form" Validation="_validator.ValidateValue" ValidationDelay="0">
		<CreateMaintObjectForm Model="Model"></CreateMaintObjectForm>
	</MudForm>
	<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateMaintObjAsync">Opslaan
		</MudButton>
		<MudButton Href="/maintobjects" Variant="Variant.Outlined" Color="Color.Primary">Annuleren
		</MudButton>
	</MudCardActions>
</MudCard>
