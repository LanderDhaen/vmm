@page "/maintobjects/create"
@using Rise.Shared.MaintObjects

<MudCard>
	<MudForm Model="@Model" @ref="_form" Validation="_validator.ValidateValue" ValidationDelay="0">
		<MudCardContent>
			<MudGrid>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">
						Serienummer
						<MudText Color="Color.Error" Inline="true">*</MudText>
					</MudText>
					<MudTextField @bind-Value="Model.SerialNumber"
					              For="@(() => Model.SerialNumber)"
					              Immediate="true"
					              Variant="Variant.Outlined"
					              Placeholder="Serienummer"
					              Adornment="Adornment.End"
					              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
					              OnAdornmentClick="OpenQrScanner"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Naam
						<MudText Color="Color.Error" Inline="true">*</MudText>
						</MudText>
					<MudTextField @bind-Value="Model.Name" For="@(() => Model.Name)" Counter="250" MaxLength="250"
					              Immediate="true" Variant="Variant.Outlined" Placeholder="Naam"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Type
						<MudText Color="Color.Error" Inline="true">*</MudText>
						</MudText>
					<MudSelect @bind-Value="Model.MaintObjType"
					           For="@(() => Model.MaintObjType)"
					           Placeholder="Selecteer een type: " Clearable="true" Variant="Variant.Outlined">
						@foreach (var type in Enum.GetValues(typeof(MaintObjType)).Cast<MaintObjType>())
						{
							<MudSelectItem Value="type">@MaintObjectUtility.TranslateType(type)</MudSelectItem>
						}
					</MudSelect>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Merk
						<MudText Typo="Typo.caption">(Optioneel)</MudText>
						</MudText>
					<MudTextField @bind-Value="Model.Brand" For="@(() => Model.Brand)"
					              Immediate="true" Variant="Variant.Outlined" Placeholder="Merk"/>
				</MudItem>

				@if (_locations != null)
				{
					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Locatie
							<MudText Color="Color.Error" Inline="true">*</MudText>
							</MudText>
						<MudSelect T="Guid?"
						           @bind-Value="Model.LocationId"
						           For="@(() => Model.LocationId)"
						           Placeholder="Selecteer een locatie"
						           Clearable="false"
						           Variant="Variant.Outlined">
							@foreach (var l in _locations)
							{
								<MudSelectItem Value="@(l.Id as Guid?)">@l.Name (@l.Address.City)</MudSelectItem>
							}
						</MudSelect>
					</MudItem>
				}
			</MudGrid>
		</MudCardContent>
	</MudForm>
	<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
		<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@CreateMaintObjAsync">Opslaan
		</MudButton>
		<MudButton Href="/maintobjects" Variant="Variant.Outlined" Color="Color.Primary">Annuleren
		</MudButton>
	</MudCardActions>
</MudCard>
