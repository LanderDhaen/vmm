@using Rise.Client.Components.MaintObjects
@using Rise.Shared.MaintObjects

@{
	switch (Modification.MaintObjModificationType)
	{
		case MaintObjModificationType.StatusChanged:
			<MudText Typo="Typo.h6">@GetTitle(Modification.MaintObjModificationType)</MudText>
			<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
				van
				
				<MaintObjStatusChip Status="@(Enum.Parse<MaintObjStatus>(Modification.PreviousValue))"/>

				naar
				
				<MaintObjStatusChip Status="@(Enum.Parse<MaintObjStatus>(Modification.CurrentValue))"/>
			</MudStack>
			break;

		case MaintObjModificationType.Scanned:
			<MudText Typo="Typo.h6">@GetTitle(Modification.MaintObjModificationType)</MudText>
			<MudText>door <b>@Modification.CurrentValue</b></MudText>
			break;

		default:
			<MudText Typo="Typo.h6">@GetTitle(Modification.MaintObjModificationType)</MudText>
			<MudText>van <b>@Modification.PreviousValue</b> naar <b>@Modification.CurrentValue</b></MudText>
			break;
	}
}
