@page "/maintobjects/edit/{MaintObjId:guid}"

@if (Model is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudCard>
		<MudForm Model="@Model" @ref="form" Validation="_validator.ValidateValue" ValidationDelay="0">
			<MudCardContent>
				<MudGrid>

				</MudGrid>
			</MudCardContent>
		</MudForm>

		<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
			<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@EditMaintObjAsync">
				Opslaan
			</MudButton>

			<MudButton Href="/maintobjects" Variant="Variant.Outlined" Color="Color.Primary">
				Annuleren
			</MudButton>
		</MudCardActions>
	</MudCard>
}
