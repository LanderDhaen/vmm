@using MudBlazor.Utilities
@inherits LayoutComponentBase

@* TODO: add footer instead of 100vh *@
<MudLayout Style="height: 100vh; background-color: #ececec">
	<NavBar/>
	<MudMainContent>
			@Body
	</MudMainContent>
</MudLayout>
<MudThemeProvider Theme="_vmm"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

@code{

	readonly MudTheme _vmm = new()
	{
		PaletteLight = new PaletteLight
		{
			Primary = new MudColor("#126B8D")
		}
	};

}
