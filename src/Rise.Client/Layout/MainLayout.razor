@namespace Rise.Client.Layout
@using Microsoft.AspNetCore.Components
@using MudBlazor

@implements IDisposable
@inherits LayoutComponentBase

<MudPopoverProvider/>

<div >
	<MudLayout>

		<div>
			<MudHidden Breakpoint="Breakpoint.SmAndDown">
				<MudCollapse Expanded="@(ShowDrawer)">
					<MudDrawer Open="@(ShowDrawer)"        
					           Variant="DrawerVariant.Persistent"  
					           Elevation="0"
					           >
						<Rise.Client.Components.DrawerMenu OnNavigate="CloseDrawerAsync" />
					</MudDrawer>
				</MudCollapse>
			</MudHidden>

			<!-- MOBILE: menuknop als MudIcon (klikbaar via @onclick) -->
			<MudHidden Breakpoint="Breakpoint.MdAndUp">
				<!-- Icon als knop (klikbaar) -->
				<MudIcon Icon="@Icons.Material.Filled.Menu"
				Class="d-flex justify-end flex-grow-1"
				
				         Style="font-size: 3rem;"
				         Color="Color.Primary"
				         @onclick="ToggleDrawerAsync"
				         title="Menu"/>

				<!-- Drawer zoals je hierboven al hebt -->
				<MudDrawer @bind-Open="_open"
				           Anchor="Anchor.Right"
				           Variant="DrawerVariant.Temporary"
				           Width="70vw"
				           Elevation="8"
				           >
					<Rise.Client.Components.DrawerMenu OnNavigate="CloseDrawerAsync" />
				</MudDrawer>
			</MudHidden>
		</div>

		<MudMainContent Style="height: 100vh;">
			<MudContainer>
				@Body
			</MudContainer>
		</MudMainContent>
	</MudLayout>

	<MudThemeProvider Theme="_vmm"/>
	<MudDialogProvider/>
	<MudSnackbarProvider/>
</div>