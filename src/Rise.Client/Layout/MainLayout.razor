@using Rise.Client.Components
@inherits LayoutComponentBase

<MudThemeProvider Theme="_vmm"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout Style="">
	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudAppBar Color="Color.Transparent" Elevation="0">
			<Breadcrumbs Items="@BreadcrumbService.Items.ToList()"></Breadcrumbs>
		</MudAppBar>
		<MudDrawer Open="true" Elevation="2" Variant="DrawerVariant.Persistent">
			<MudDrawerHeader Style="width:100%; padding:0; margin:0; display:block;">
				<MudImage Src="/img/logo.png"
				          Alt="Logo"
				          Style="width:100%; height:auto; object-fit:contain; display:block; margin:0;"/>
			</MudDrawerHeader>
			<MudNavMenu>
				<MudNavLink Href="/projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Folder"
				            IconColor="Color.Inherit">Projecten
				</MudNavLink>
				<MudNavLink Href="/stations" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Map"
				            IconColor="Color.Inherit">Meetstations
				</MudNavLink>
				<MudNavLink Href="/apparaten" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ImportantDevices"
				            IconColor="Color.Inherit">Apparaten
				</MudNavLink>
				<MudNavLink Href="/werkbonnen" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Archive"
				            IconColor="Color.Inherit">Werkbonnen
				</MudNavLink>
				<MudNavLink Href="/account" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalance"
				            IconColor="Color.Inherit">Account
				</MudNavLink>
				<MudNavLink Href="/instellingen" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Settings"
				            IconColor="Color.Inherit">Account
				</MudNavLink>
			</MudNavMenu>
		</MudDrawer>
	</MudHidden>

	@* Mobile *@
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<div class="d-flex justify-space-between align-center p-4">
			<Header Title="@HeaderService.State.Title" Icon="@HeaderService.State.Icon"
			        OnBack="@EventCallback.Factory.Create(this, () => HeaderService.State.OnBack?.Invoke() ?? Task.CompletedTask)"></Header>
			<MudIconButton Class="p-0" Icon="@Icons.Material.Filled.Menu"
			               Size="Size.Large"
			               Color="Color.Primary"
			               OnClick="@ToggleDrawer"
			               title="Menu"/>
		</div>
		<MudDrawer @bind-Open="_open" Elevation="2" Variant="DrawerVariant.Temporary" Anchor="Anchor.Right"
		           OverlayAutoClose="true">
			<MudDrawerHeader Style="width:100%; padding:0; margin:0; display:block;">
				<MudImage Src="/img/logo.png"
				          Alt="Logo"
				          Style="width:100%; height:auto; object-fit:contain; display:block; margin:0;"/>
			</MudDrawerHeader>
			<MudNavMenu>
				<MudNavLink Href="/projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Folder"
				            IconColor="Color.Inherit">Projecten
				</MudNavLink>
				<MudNavLink Href="/stations" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Map"
				            IconColor="Color.Inherit">Meetstations
				</MudNavLink>
				<MudNavLink Href="/apparaten" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ImportantDevices"
				            IconColor="Color.Inherit">Apparaten
				</MudNavLink>
				<MudNavLink Href="/werkbonnen" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Archive"
				            IconColor="Color.Inherit">Werkbonnen
				</MudNavLink>
				<MudNavLink Href="/account" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Person"
				            IconColor="Color.Inherit">Account
				</MudNavLink>
				<MudNavLink Href="/instellingen" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Settings"
				            IconColor="Color.Inherit">Instellingen
				</MudNavLink>
			</MudNavMenu>
		</MudDrawer>
		<MudMainContent Style="height: 100vh;" Class="pt-0">
			<MudContainer>
				@Body
			</MudContainer>
		</MudMainContent>
	</MudHidden>

	<MudMainContent Style="height: 100vh;">
		<MudContainer>
			@Body
		</MudContainer>
	</MudMainContent>
</MudLayout>
