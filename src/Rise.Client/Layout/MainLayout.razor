@namespace Rise.Client.Layout
@using Microsoft.AspNetCore.Components
@using MudBlazor

@implements IDisposable
@inherits LayoutComponentBase

<MudPopoverProvider/>

	<MudLayout>
			<MudHidden Breakpoint="Breakpoint.SmAndDown">
					<MudDrawer Open="@(ShowDrawer)"        
					           Variant="DrawerVariant.Persistent"  
					           Elevation="2"
					           >
						<Rise.Client.Components.DrawerMenu OnNavigate="CloseDrawerAsync" />
					</MudDrawer>
			</MudHidden>

			<MudHidden Breakpoint="Breakpoint.MdAndUp">
			<MudPaper Class="d-flex justify-end flex-grow-1 mt-20 mb-n15" Elevation="0">
							<MudIcon Icon="@Icons.Material.Filled.Menu"
							         Class="mr-4  mb-n20"			
				               Style="font-size: 3rem;"
				               Color="Color.Primary"
				               @onclick="ToggleDrawerAsync"
				               title="Menu"/>
			</MudPaper>
				<MudDrawer @bind-Open="_open"
				           Anchor="Anchor.Right"
				           Variant="DrawerVariant.Temporary"
				           Width="70vw"
				           Elevation="2"
				           >
					<Rise.Client.Components.DrawerMenu OnNavigate="CloseDrawerAsync" />
				</MudDrawer>
			</MudHidden>

		<MudMainContent Style="height: 100vh;">
			<MudContainer>
				@Body
			</MudContainer>
		</MudMainContent>
	</MudLayout>

	<MudThemeProvider Theme="_vmm"/>
	<MudDialogProvider/>
	<MudSnackbarProvider/>