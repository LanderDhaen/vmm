@inject NavigationManager NavigationManager

<MudAppBar Elevation="1" Color="Color.Primary" Dense="true" Class="navbar"
Style="background: linear-gradient(to top, #ffffff, #ffffff); padding: 10px;"  Fixed="false">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        @if (NavigationManager.Uri.EndsWith("/")) // Controleer of we op de homepage zijn
        {    
            <MudButton
                Href="/projects"
                Color="Color.Default"
                Variant="Variant.Text"
                Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC); margin: 0.5rem;"
            >Projecten</MudButton>
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIos" Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC); margin: 0.5rem;"/>
        }
    
        <MudSpacer/>
    </MudStack>

    <MudSpacer />
    
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        <MudIconButton Icon="@Icons.Material.Filled.HowToReg" Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC); margin: 0.5rem;"/>
    </MudStack>
</MudAppBar>

<style>
    .navbar {

        padding: 0 1rem;
    }

    .fw-600 {
        font-weight: 600;
    }
</style>
