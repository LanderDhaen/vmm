@inject NavigationManager NavigationManager
<MudAppBar Style=" background-color: white;" Fixed="false">        
@if (NavigationManager.Uri.EndsWith("/")) // Controleer of we op de homepage zijn
        {    
            <MudButton
            Href="/projects"
            Color="Color.Default"
            Variant="Variant.Text"
            Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC);"
            >Sites</MudButton>
           // Toon de tekst "Sites" op de homepage
        }


        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBackIos" Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC);"/>
        }
    
    <MudSpacer/>
    <MudIconButton Icon="@Icons.Material.Filled.HowToReg"  Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC);"/>
</MudAppBar>
