<MudAppBar Style=" background-color: white;" Fixed="false">
    <MudButton
        Href="/projects"
        Color="Color.Default"
        Variant="Variant.Text"
    ><MudIconButton Icon="@Icons.Material.Filled.ArrowBackIos" Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC);"/>
    </MudButton>
    <MudSpacer/>
    <MudIconButton Icon="@Icons.Material.Filled.HowToReg"  Style="border-radius: 5px; color: gray; background: linear-gradient(to top, #BAE6FD, #7DD3FC);"/>
</MudAppBar>
<MudAppBar Style="background: linear-gradient(to top, #BAE6FD, #7DD3FC);"  Fixed="false">
    <MudTextField @bind-Value="Search" Label="Zoek" 
    Variant="Variant.Filled" Adornment="Adornment.End" 
    AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Inherit" 
    Style="width: 200px; background-color: white; color: gray;" /> <!-- Pas de breedte aan -->
    <MudSpacer/>
    <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" Style="color: gray;"/>
</MudAppBar>
@code {
    public string Search { get; set; }
    
    public NavBar() // Zorg ervoor dat de naam van de klasse correct is
    {
        Search = string.Empty; // Initialiseer met een lege string
    }
}
