@page "/projects/create"

<MudText Typo="Typo.h3">Project toevoegen</MudText>
<MudCard>
	<MudForm Model="@Model" @ref="form" Validation="validator.ValidateValue" ValidationDelay="0">
		<MudCardContent>
			<MudGrid>
				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
					<MudTextField @bind-Value="Model.Code" For="@(() => Model.Code)" Counter="50" MaxLength="50"
					              Immediate="true" Variant="Variant.Outlined" Placeholder="Referentienummer"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Naam</MudText>
					<MudTextField @bind-Value="Model.Name" For="@(() => Model.Name)" Counter="250" MaxLength="250"
					              Immediate="true" Variant="Variant.Outlined" Placeholder="Naam"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Start datum</MudText>
					<MudDatePicker @bind-Date="Model.StartDate" For="@(() => Model.StartDate)" DateFormat="dd/MM/yyyy"
					               Variant="Variant.Outlined"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					@if (networks != null)
					{
						<MudText Typo="Typo.subtitle2">Meetnet</MudText>
						<MudAutocomplete T="Guid?" SearchFunc="Search"
						                 ToStringFunc="id => networks.FirstOrDefault(x => x.Id == id)?.Name ?? string.Empty"
						                 @bind-Value="Model.MeasurementNetworkId"
						                 For="@(() => Model.MeasurementNetworkId)"
						                 Placeholder="Selecteer een meetnet: " Clearable="true"
						                 Variant="Variant.Outlined">
						</MudAutocomplete>
					}
				</MudItem>
			</MudGrid>
		</MudCardContent>
	</MudForm>
	<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateProjectAsync">Opslaan
		</MudButton>
		<MudButton Href="/projects" Variant="Variant.Outlined" Color="Color.Primary">Annuleren
		</MudButton>
	</MudCardActions>
</MudCard>