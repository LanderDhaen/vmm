@page "/projects/create"

<MudCard>
	<MudForm Model="@Model" @ref="form" Validation="validator.ValidateValue" ValidationDelay="0">
		<MudCardContent>
			<MudGrid>
				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
					<MudTextField @bind-Value="Model.Code" For="@(() => Model.Code)" Counter="50" MaxLength="50"
					              Immediate="true" Variant="Variant.Outlined" Placeholder="Referentienummer"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Naam</MudText>
					<MudTextField @bind-Value="Model.Name" For="@(() => Model.Name)" Counter="250" MaxLength="250"
					              Immediate="true" Variant="Variant.Outlined" Placeholder="Naam"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Start datum</MudText>
					<MudDatePicker @bind-Date="Model.StartDate" For="@(() => Model.StartDate)" DateFormat="dd/MM/yyyy"
					               Variant="Variant.Outlined"/>
				</MudItem>

				<MudItem xs="12" sm="6">
					@if (networks != null)
					{
						<MudText Typo="Typo.subtitle2">Meetnet</MudText>
						<MudSelect T="Guid?" @bind-Value="Model.MeasurementNetworkId" For="@(() => Model.MeasurementNetworkId)"
						           Placeholder="Selecteer een meetnet: " Clearable="true" Variant="Variant.Outlined">
							@foreach (var network in networks)
							{
								<MudSelectItem Value="@(network.Id as Guid?)">@network.Name</MudSelectItem>
							}
						</MudSelect>
					}
				</MudItem>
			</MudGrid>
		</MudCardContent>
	</MudForm>
	<MudCardActions>
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@CreateProjectAsync">Opslaan
		</MudButton>
		<MudButton Href="/projects" Variant="Variant.Filled" Color="Color.Primary" Class="mr-auto">Annuleren
		</MudButton>
	</MudCardActions>
</MudCard>