@page "/projects/create"
@using Rise.Client.Components.Projects

<MudCard>
	<MudForm Model="@Model" @ref="form" Validation="_validator.ValidateValue" ValidationDelay="0">
		<CreateProjectForm Model="Model"></CreateProjectForm>
	</MudForm>
	<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
		<MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
		           OnClick="@CreateProjectAsync">Opslaan
		</MudButton>
		<MudButton Href="/projects" Variant="Variant.Outlined" Color="Color.Primary">Annuleren
		</MudButton>
	</MudCardActions>
</MudCard>