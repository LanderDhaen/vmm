@using Rise.Client.Components
@using Rise.Shared.Stations
<MudOverlay @bind-Visible="Visible" DarkBackground>
	<MudPaper Class="pa-6 mx-auto">
		<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
			<MudText Typo="Typo.h5">Lijst meetstations bewerken</MudText>
			<MudIconButton Icon="@Icons.Material.Filled.Close"
			               Size="Size.Medium"
			               OnClick="@CloseOverlay"
			/>
		</MudStack>

		<MudRadioGroup @bind-Value="_selectedOption">
			<MudRadio Value="@("Bestaand")">Bestaand meetstation toevoegen of verwijderen</MudRadio>
			<MudRadio Value="@("Nieuw")">Nieuw meetstation toevoegen</MudRadio>
		</MudRadioGroup>

		@switch (_selectedOption)
		{
			case "Bestaand":
				<SearchField Value="@_searchTerm" ValueChanged="@UpdateSearch"
				             Label="Zoek meetstation"></SearchField>

				<MudTable T="MeasurementStationDto.Index" Items="@_allStations" Hover="true" CustomHeader="true">
					<HeaderContent>
						<MudTHeadRow>
							<MudTh Class="mud-theme-primary"></MudTh>
							<MudTh Class="mud-theme-primary">#</MudTh>
							<MudTh Class="mud-theme-primary">Locatie</MudTh>
							<MudTh Class="mud-theme-primary">Gemeente</MudTh>
						</MudTHeadRow>
					</HeaderContent>
					<RowTemplate>
						<MudCheckBox Value="@Model.MeasurementStationIds.Contains(context.Id)"
						             ValueChanged="@((bool value) => OnCheckboxChanged(context.Id, value))"/>
						<MudTd DataLabel="#">@context.Code</MudTd>
						<MudTd DataLabel="Locatie">@context.Location</MudTd>
						<MudTd DataLabel="Gemeente">@context.City</MudTd>
					</RowTemplate>
				</MudTable>

				<MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.End" Class="py-4">
					<MudButton Variant="Variant.Filled"
					           StartIcon="@Icons.Material.Filled.PlaylistAdd"
					           Size="Size.Small"
					           Color="Color.Primary"
					           OnClick="@UpdateMeasurementStations">
						Opslaan
					</MudButton>
					<MudButton OnClick="@CloseOverlay" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Annuleren
					</MudButton>
				</MudStack>
				break;
			case "Nieuw":
					break;
		}
	</MudPaper>
</MudOverlay>