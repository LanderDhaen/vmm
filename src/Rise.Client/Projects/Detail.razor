@page "/projects/{ProjectId:guid}"
@using Rise.Shared.Projects

<PageTitle>Project Details</PageTitle>


@if (_project is null)
{
	<MudProgressCircular Indeterminate="true"/>
}
else
{
	<MudContainer Class="mt-2 px-2">
		<MudPaper>
			<MudTabs Rounded="true" Centered="true" Border="true">
				<MudTabPanel Text="Informatie">
					<MudGrid>
						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="mb-1">Referentienummer</MudText>
							<MudText Typo="Typo.body2" Class="mb-1">@_project.Code</MudText>

						</MudItem>

						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="mb-1">Site</MudText>
							<MudText Typo="Typo.body2" Class="mb-1">@_project.Location.Name</MudText>

						</MudItem>
						
						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="mb-1">Stad</MudText>
							<MudText Typo="Typo.body2" Class="mb-1">@_project.Location.Address.City</MudText>

						</MudItem>
						
						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="mb-1">Provincie</MudText>
							<MudText Typo="Typo.body2" Class="mb-1">TODO</MudText>

						</MudItem>
						
						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="mb-1">Regio</MudText>
							<MudText Typo="Typo.body2" Class="mb-1">TODO</MudText>

						</MudItem>
						
						<MudItem xs="12">
							<MudText Typo="Typo.subtitle2" Class="mb-1">Opmerkingen</MudText>
							<MudText Typo="Typo.body2" Class="mb-1">...</MudText>

						</MudItem>
					</MudGrid>
				</MudTabPanel>

				<MudTabPanel Text="Kaart">
					<MudText Typo="Typo.body1">[Kaartcomponent komt hier]</MudText>
				</MudTabPanel>

				<MudTabPanel Text="Meetstations">
					<MudText Typo="Typo.body1">[Lijst van meetstations]</MudText>
				</MudTabPanel>
				<MudTabPanel Text="...">
					<MudText Typo="Typo.body1">[DROP DOWN]</MudText>
				</MudTabPanel>
			</MudTabs>
		</MudPaper>

	</MudContainer>
}