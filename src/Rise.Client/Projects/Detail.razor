@page "/projects/{ProjectId:guid}"
@using Rise.Shared.Projects

<PageTitle>Project Details</PageTitle>


@if (_project is null)
{
	<MudProgressCircular Indeterminate="true"/>
}
else
{
	<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-2 px-2">
		<MudPaper Class="pa-4" Elevation="1">
			@* TODO: buttongroup? *@
			<MudButtonGroup Exclusive="true" Color="Color.Primary" Class="mb-3">
				<MudButton>Informatie</MudButton>
				<MudButton>Kaart</MudButton>
				<MudButton>Meetstations</MudButton>
				<MudButton>...</MudButton>
			</MudButtonGroup>
			<MudStack Spacing="2">
				<MudText Typo="Typo.subtitle2" Color="Color.Secondary">Referentienummer</MudText>
				<MudText Typo="Typo.body1" Class="font-weight-medium">@_project.Code</MudText>

				<MudText Typo="Typo.subtitle2" Color="Color.Secondary">Site</MudText>
				<MudText Typo="Typo.body1" Class="font-weight-medium">@_project.Location.Name</MudText>

				<MudText Typo="Typo.subtitle2" Color="Color.Secondary">Stad</MudText>
				<MudText Typo="Typo.body1" Class="font-weight-medium">
					@_project.Location.Address.PostalCode, @_project.Location.Address.City
				</MudText>

				<MudText Typo="Typo.subtitle2" Color="Color.Secondary">Provincie</MudText>
				<MudText Typo="Typo.body1" Class="font-weight-medium">
					@_project.Location.Address.AddressLine2
				</MudText>

				<MudText Typo="Typo.subtitle2" Color="Color.Secondary">Regio</MudText>
				<MudText Typo="Typo.body1" Class="font-weight-medium">
					Conductiviteitmeetnet West
				</MudText>

				<MudText Typo="Typo.subtitle2" Color="Color.Secondary">Opmerkingen</MudText>
				<MudTextField T="string"
				              Lines="4"
				              Variant="Variant.Outlined"
				              Placeholder="Voeg opmerkingen toe..."
				              ReadOnly="true"/>
			</MudStack>

		</MudPaper>
	</MudContainer>
}