@page "/projects/{ProjectId:guid}"
@inject NavigationManager Navigation
<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:70vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudContainer MaxWidth="MaxWidth.Medium">
		<div>
			@* TODO: achtergrond tab doorzichtig maken *@
			@* TODO: iets anders dan tabs gebruiken? *@
			<MudTabs Border="false" Centered="true" MinimumTabWidth="10px">
				<!-- INFO TAB -->
				<MudTabPanel Text="Info">
					<MudStack>
						@* TODO: mudtextfield ipv mudpaper *@
						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
							<MudPaper Class="p-2">@_project.Code</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Name</MudText>
							<MudPaper Class="p-2">@_project.Name</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Site</MudText>
							<MudPaper Class="p-2">@_project.Location.Name</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Start datum</MudText>
							<MudPaper Class="p-2">@_project.DateRange.StartDate</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Eind datum</MudText>
							<MudPaper Class="p-2">@_project.DateRange.EndDate</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Adres 1</MudText>
							<MudPaper
								Class="p-2">@_project.Location.Address.AddressLine1 </MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Adres 2</MudText>
							<MudPaper
								Class="p-2"> @_project.Location.Address.AddressLine2 </MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Stad</MudText>
							<MudPaper
								Class="p-2">@_project.Location.Address.City </MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Postcode</MudText>
							<MudPaper
								Class="p-2">@_project.Location.Address.PostalCode</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Land</MudText>
							<MudPaper
								Class="p-2">@_project.Location.Address.CountryIso </MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Provincie</MudText>
							<MudPaper Class="p-2">TODO</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Regio</MudText>
							<MudPaper Class="p-2">TODO</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Opmerkingen</MudText>
							<MudTextField
								@bind-Value="_remarks"
								FullWidth="true"
								Lines="4"
								Class="white"/>
						</MudItem>
					</MudStack>
				</MudTabPanel>

				<!-- MAP TAB -->
				<MudTabPanel Text="Kaart">
					<MudContainer Class="pa-4">
						<MudStack Justify="Justify.Center">
							<MudItem>
								<MudText Typo="Typo.subtitle2" Class="text-secondary">Breedtegraad</MudText>
								<MudPaper
									Class="p-2 "> @_project.Location.Coordinate.Y.ToString("F5")
								</MudPaper>
							</MudItem>

							<MudItem>
								<MudText Typo="Typo.subtitle2" Class="text-secondary">Lengtegraad</MudText>
								<MudPaper
									Class="p-2"> @_project.Location.Coordinate.X.ToString("F5")
								</MudPaper>
							</MudItem>
						</MudStack>
					</MudContainer>
					<MudContainer Class="p-4">
						<MudPaper>
							<div style="width: 100%; height: 400px; border-radius: 4px; overflow: hidden;">
								<RealTimeMap Parameters="_parameters" height="400px" width="100%"></RealTimeMap>
							</div>
						</MudPaper>
					</MudContainer>

				</MudTabPanel>

				<!-- MEETSTATIONS -->
				<MudTabPanel Text="Meetstations">
					<MudText Typo="Typo.body1">[Lijst van meetstations]</MudText>
				</MudTabPanel>

				<!-- HISTORY -->
				<MudTabPanel Text="..." OnClick="NavigateToHistory"></MudTabPanel>
			</MudTabs>

			<MudButton Icon="@Icons.Material.Filled.MoreHoriz" OnClick="NavigateToHistory"/>
		</div>
	</MudContainer>
}