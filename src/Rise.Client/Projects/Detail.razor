@page "/projects/{ProjectId:guid}"
@using Rise.Client.Components
@using Rise.Shared.Projects
@inject NavigationManager Navigation
<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	// Desktop

	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudDrawer @bind-open="@_open" Anchor="Anchor.Right" Elevation="1" Variant="DrawerVariant.Temporary">
			<MudDrawerHeader>Acties</MudDrawerHeader>
			<MudButton StartIcon="@Icons.Material.Filled.Cancel">Project afsluiten</MudButton>
		</MudDrawer>
		<MudBreadcrumbs Items="_items" Class="p-0 m-2 gutter-2">
			<SeparatorTemplate>
				<MudIcon Icon="@Icons.Material.Filled.ArrowRight" Size="Size.Small"/>
			</SeparatorTemplate>
		</MudBreadcrumbs>
	</MudHidden>

	// Mobile
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<MudDrawer @bind-open="@_open" Anchor="Anchor.Bottom" Elevation="1" Variant="DrawerVariant.Temporary">
			<MudDrawerHeader>Acties</MudDrawerHeader>
			<MudButton StartIcon="@Icons.Material.Filled.Cancel">Project afsluiten</MudButton>
		</MudDrawer>
		<ArrowHeader Title="Site" OnBack="NavigateToProjects"/>
		@* <Header Title="Projecten"></Header> *@
	</MudHidden>

	// ====== Tabs ======
	<div class="d-flex justify-space-between m-2 align-center" role="tablist" aria-label="Project tabs">
		<MudText
			Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
			@onclick="() => SetTab(0)">
			@_tabs[0]
		</MudText>

		<MudText
			Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
			@onclick="() => SetTab(1)">
			@_tabs[1]
		</MudText>

		<MudText
			Class="@($"tab-item {(_selectedTab == 2 ? "active" : "")}")"
			@onclick="() => SetTab(2)">
			@_tabs[2]
		</MudText>
		<MudDivider Vertical="true" FlexItem="true"/>
		<MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
			<MudIconButton Icon="@Icons.Material.Filled.MoreHoriz" OnClick="@(() => OpenDrawer())"></MudIconButton>
		</MudHidden>
		<MudHidden Breakpoint="Breakpoint.Xs">
			<MudButton Variant="Variant.Text" OnClick="@(() => OpenDrawer())">Acties</MudButton>
		</MudHidden>
	</div>


	@switch (_selectedTab)
	{
		/* Conditionally render the panels based on the selected index */
		case 0:
			//name and edit icon
			<div class="d-flex align-center m-2">
				@* TODO: to complex for now *@
				@* <MudBadge Color="@_project.Status.Equals(Status.Actief) ? Color.Success : Color.Error" Dot="true" *@
				@* Origin="Origin.CenterLeft" *@
				@* BadgeAriaLabel="Project Status"> *@
				@* </MudBadge> *@
				@if (_project.Status.Equals(Status.Actief))
				{
					<MudBadge Dot="true" Color="Color.Success" Origin="Origin.CenterLeft">
						<MudText Class="p-4" Typo="Typo.h5">@_project.Name</MudText>
					</MudBadge>
					<MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"></MudIcon>
				}
				else
				{
					<MudBadge Dot="true" Color="Color.Error" Origin="Origin.CenterLeft">
						<MudText Class="p-4" Typo="Typo.h5">@_project.Name</MudText>
					</MudBadge>
				}
			</div>

			//details grid
			// TODO: use MudTextField for editable fields
			<MudGrid Class="p-2">
				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
					<MudPaper Class="p-2">@_project.Code</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Naam</MudText>
					<MudPaper Class="p-2">@_project.Name</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Start datum</MudText>
					<MudPaper Class="p-2">@_project.StartDate</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Eind datum</MudText>
					<MudPaper Class="p-2">@_project.EndDate</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Meetnet</MudText>
					<MudPaper Class="p-2">@_project.MeasurementNetwork</MudPaper>
				</MudItem>

				<MudItem xs="12" sm="6">
					<MudText Typo="Typo.subtitle2">Zone</MudText>
					<MudPaper Class="p-2">@_project.Zone</MudPaper>
				</MudItem>

				<MudItem xs="12">
					<MudText Typo="Typo.subtitle2">Opmerkingen</MudText>
					<MudTextField
						@bind-Value="_remarks"
						FullWidth="true"
						Lines="4"
						Class="white"/>
				</MudItem>
			</MudGrid>
			break;
		case 1:
			<MudText Typo="Typo.body1">[Lijst van meetstations]</MudText>
			break;
		case 2:
			<MudText Typo="Typo.body1">[Lijst van historiek]</MudText>
			break;
	}
}
