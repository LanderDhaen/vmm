@page "/projects/{ProjectId:guid}"
@using Rise.Shared.Projects
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudDrawer @bind-open="@_open" Anchor="Anchor.Right" Elevation="1" Variant="DrawerVariant.Temporary">
			<MudDrawerHeader>Acties</MudDrawerHeader>
			<MudButton StartIcon="@Icons.Material.Filled.Cancel"
			           Color="Color.Error"
			           OnClick="ShowCloseConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Afgesloten)">
				Project afsluiten
			</MudButton>

			<MudButton StartIcon="@Icons.Material.Filled.Check"
			           Color="Color.Success"
			           OnClick="ShowStartConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Actief)">
				Project opstarten
			</MudButton>
		</MudDrawer>
	</MudHidden>

	// Mobile
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<MudDrawer @bind-open="@_open" Anchor="Anchor.Bottom" Elevation="1" Variant="DrawerVariant.Temporary">
			<MudDrawerHeader>Acties</MudDrawerHeader>
			<MudButton StartIcon="@Icons.Material.Filled.Cancel"
			           Color="Color.Error"
			           OnClick="ShowCloseConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Afgesloten)">
				Project afsluiten
			</MudButton>

			<MudButton StartIcon="@Icons.Material.Filled.Check"
			           Color="Color.Success"
			           OnClick="ShowStartConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Actief)">
				Project opstarten
			</MudButton>
		</MudDrawer>
	</MudHidden>

	// ====== Tabs ======
	<div class="d-flex justify-space-between m-4 align-center" role="tablist" aria-label="Project tabs">
		<MudText
			Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
			@onclick="() => SetTab(0)">
			@_tabs[0]
		</MudText>

		<MudText
			Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
			@onclick="() => SetTab(1)">
			@_tabs[1]
		</MudText>

		<MudText
			Class="@($"tab-item {(_selectedTab == 2 ? "active" : "")}")"
			@onclick="() => SetTab(2)">
			@_tabs[2]
		</MudText>
		<MudDivider Vertical="true" FlexItem="true"/>
		<MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
			<MudIconButton Icon="@Icons.Material.Filled.MoreHoriz" OnClick="@OpenDrawer"></MudIconButton>
		</MudHidden>
		<MudHidden Breakpoint="Breakpoint.Xs">
			<MudButton Variant="Variant.Text" OnClick="@OpenDrawer">Acties</MudButton>
		</MudHidden>
	</div>


	@switch (_selectedTab)
	{
		case 0:
			<MudPaper Class="p-4">

				<div class="d-flex align-center m-2">
					@* name: mobile uses a Badge, desktop uses plain Text *@
					<MudHidden Breakpoint="Breakpoint.Xs" Invert="true">
						<MudBadge Dot="true" Color="BadgeColor" Origin="Origin.CenterLeft">
							<MudText Class="pl-4" Typo="Typo.h5">@_project.Name</MudText>
						</MudBadge>
					</MudHidden>

					<MudHidden Breakpoint="Breakpoint.Xs">
						<MudText Class="pr-2" Typo="Typo.h5">@_project.Name</MudText>
					</MudHidden>

					<MudHidden Breakpoint="Breakpoint.Xs">
						<MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
						         Color="BadgeColor">@_project.Status
						</MudChip>
					</MudHidden>

					@* edit button *@
					<MudTooltip Delay="400"
					            Placement="Placement.Right"
					            Text="@(IsActive ? "Project bewerken" : "Afgesloten project kan niet bewerkt worden")">
						<MudIconButton
							Href="@($"/projects/edit/{ProjectId}")"
							Disabled="@(!IsActive)"
							Icon="@Icons.Material.Filled.Edit"
							Color="Color.Primary"
							AriaLabel="@(IsActive ? "Project bewerken" : "Afgesloten project")"/>
					</MudTooltip>

					@* chip only shown on desktop *@

				</div>

				@* //details grid *@
				@* // TODO: use MudTextField for editable fields *@

				<MudGrid Class="p-2">
					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
						<MudTextField T="string" @bind-Value="_project.Code" ReadOnly="true" Class="p-2"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Naam</MudText>
						<MudTextField T="string" @bind-Value="_project.Name" ReadOnly="true" Class="p-2"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Start datum</MudText>
						<MudTextField T="DateOnly" @bind-Value="_project.StartDate" ReadOnly="true" Class="p-2"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Eind datum</MudText>
						<MudTextField T="DateOnly?" @bind-Value="_project.EndDate" ReadOnly="true" Class="p-2"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Meetnet</MudText>
						<MudTextField T="string" @bind-Value="_project.MeasurementNetwork.Name" ReadOnly="true"
						              Class="p-2"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Zone</MudText>
						<MudTextField T="string" @bind-Value="_project.Zone" ReadOnly="true" Class="p-2"/>
					</MudItem>

					<MudItem xs="12">
						<MudText Typo="Typo.subtitle2">Opmerkingen</MudText>
						<MudTextField
							@bind-Value="_remarks"
							ReadOnly="true"
							FullWidth="true"
							Lines="4"
							Class="white"/>
					</MudItem>
				</MudGrid>
			</MudPaper>
			break;
		case 1:
			<MeasurementStations ProjectId="ProjectId" IsActive="IsActive" TabChanged="@OnTabChange"/>
			break;
		case 2:
			<History ProjectId="ProjectId"/>
			break;
	}
}