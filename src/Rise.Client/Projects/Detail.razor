@page "/projects/{ProjectId:guid}"
    @using Rise.Shared.Projects
    
    <PageTitle>Project Details</PageTitle>
    
    @if (_project is null) {
        <MudProgressCircular Indeterminate="true"/>
    } else {
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
            <MudPaper Class="pa-6" Elevation="1">
                <MudStack Spacing="4">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                                           Href="/projects" 
                                           Size="Size.Large"/>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">Site</MudText>
                        </MudStack>
                        <MudAvatar Color="Color.Primary" Size="Size.Medium">LD</MudAvatar>
                    </MudStack>
    
                    <MudTabs Elevation="0" Rounded="true" PanelClass="pa-0">
                        <MudTabPanel Text="Informatie"/>
                        <MudTabPanel Text="Kaart"/>
                        <MudTabPanel Text="Meetstations"/>
                        <MudTabPanel Text="..."/>
                    </MudTabs>
    
                    <MudDivider/>
    
                    <MudStack Spacing="3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Referentienummer</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-medium">@_project.Code</MudText>
                        </MudStack>
    
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Site</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-medium">@_project.Location.Name</MudText>
                        </MudStack>
    
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Stad</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-medium">@_project.Location.Address.PostalCode, @_project.Location.Address.City</MudText>
                        </MudStack>
    
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Provincie</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-medium">@_project.Location.Address.AddressLine2</MudText>
                        </MudStack>
    
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Regio</MudText>
                            <MudText Typo="Typo.body1" Class="font-weight-medium">Conductiviteitmeetnet West</MudText>
                        </MudStack>
    
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Opmerkingen</MudText>
                        </MudStack>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudContainer>
    }