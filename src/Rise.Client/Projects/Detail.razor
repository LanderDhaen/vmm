@page "/projects/{ProjectId:guid}"
@using Rise.Client.Components
@inject NavigationManager Navigation
<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	@* Desktop *@
	<MudHidden Breakpoint="Breakpoint.SmAndDown">
		<MudBreadcrumbs Items="_items">
			<SeparatorTemplate>
				<MudIcon Icon="@Icons.Material.Filled.ArrowRight" Size="Size.Small"/>
			</SeparatorTemplate>
		</MudBreadcrumbs>
	</MudHidden>

	@* Mobile *@
	<MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
		<ArrowHeader Title="Site" OnBack="NavigateToProjects"/>

	</MudHidden>

	@* <div class="d-flex justify-space-between p-4 align-center"> *@
	@* 	<MudText>Info</MudText> *@
	@* 	<MudText>Meetstations</MudText> *@
	@* 	<MudText>Historiek</MudText> *@
	@* 	<MudDivider Vertical="true" FlexItem="true"/> *@
	@* 	<MudIcon Icon="@Icons.Material.Outlined.MoreHoriz"></MudIcon> *@
	@* </div> *@

	<div class="d-flex justify-space-between p-4 align-center" role="tablist" aria-label="Project tabs">
		<MudText
			Style="cursor: pointer; @(_selectedTab == 0 ? "border-bottom: 2px solid; border-color:gray;" : "")"
			@onclick="() => SetTab(0)"
			role="tab"
			aria-selected="@(_selectedTab == 0)">
			Info
		</MudText>

		<MudText
			Style="cursor: pointer; @(_selectedTab == 1 ? "border-bottom: 2px solid; border-color:gray;" : "")"
			@onclick="() => SetTab(1)"
			role="tab"
			aria-selected="@(_selectedTab == 1)">
			Meetstations
		</MudText>

		<MudText
			Style="cursor: pointer; @(_selectedTab == 2 ? "border-bottom: 2px solid; border-color:gray;" : "")"
			@onclick="() => SetTab(2)"
			role="tab"
			aria-selected="@(_selectedTab == 2)">
			Historiek
		</MudText>

		<MudDivider Vertical="true" FlexItem="true"/>
		<MudIcon Icon="@Icons.Material.Outlined.MoreHoriz"></MudIcon>
	</div>

	@* Conditionally render the panels based on the selected index *@
	@if (_selectedTab == 0)
	{
		<div class="d-flex align-center mt-2 mb-2">
			<MudText Class="p-2" Typo="Typo.h5">@_project.Name</MudText>
			<MudIcon Icon="@Icons.Material.Filled.Edit" Style="color: #7DD3FC"></MudIcon>
		</div>
		<MudStack>
			<MudItem Class="m-2">
				<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
				<MudPaper Class="p-2">@_project.Code</MudPaper>
			</MudItem>

			<MudItem Class="m-2">
				<MudText Typo="Typo.subtitle2">Naam</MudText>
				<MudPaper Class="p-2">@_project.Name</MudPaper>
			</MudItem>

			<MudItem Class="m-2">
				<MudText Typo="Typo.subtitle2">Start datum</MudText>
				<MudPaper Class="p-2">@_project.StartDate</MudPaper>
			</MudItem>

			<MudItem Class="m-2">
				<MudText Typo="Typo.subtitle2">Eind datum</MudText>
				<MudPaper Class="p-2">@_project.EndDate</MudPaper>
			</MudItem>

			<MudItem Class="m-2">
				<MudText Typo="Typo.subtitle2">Meetnet</MudText>
				<MudPaper Class="p-2">@_project.MeasurementNetwork</MudPaper>
			</MudItem>

			<MudItem Class="m-2">
				<MudText Typo="Typo.subtitle2">Zone</MudText>
				<MudPaper Class="p-2">@_project.Zone</MudPaper>
			</MudItem>

			<MudItem Class="m-2">
				<MudText Typo="Typo.subtitle2">Opmerkingen</MudText>
				<MudTextField
					@bind-Value="_remarks"
					FullWidth="true"
					Lines="4"
					Class="white"/>
			</MudItem>
		</MudStack>
	}
	else if (_selectedTab == 1)
	{
		<MudText Typo="Typo.body1">[Lijst van meetstations]</MudText>
	}
	else if (_selectedTab == 2)
	{
		<MudText Typo="Typo.body1">[Lijst van historiek]</MudText>
	}

	@code {

	}
}
