@page "/projects/{ProjectId:guid}"
@using Rise.Shared.Projects
@inject NavigationManager Navigation

<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	@* Tabs *@
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pt-4">
		<MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Spacing="8">
			<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
			         @onclick="() =>  SetTab(0)">
				@_tabs[0]
			</MudText>

			<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
			         @onclick="() =>  SetTab(1)">
				@_tabs[1]
			</MudText>
		</MudStack>
	</MudStack>

	@switch (_selectedTab)
	{
		case 0:
			<MudGrid Spacing="4">
				
				@* Toolbar *@
				
				<MudItem xs="12" Class="d-flex justify-end mt-2">
						@if (_project.Status.Equals(Status.Afgesloten))
						{
							<MudButton StartIcon="@Icons.Material.Filled.RocketLaunch" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
							           OnClick="@ShowStartConfirmationAsync">
								Opstarten
							</MudButton>
						}
						else
						{
							<MudButton StartIcon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
							           OnClick="@ShowCloseConfirmationAsync">Afsluiten
							</MudButton>
						}
				</MudItem>

				@* Details *@
				<MudItem xs="12" md="6">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">@_project.Code</MudText>
									<MudTooltip Delay="400"
									            Text="@(IsActive ? "Project bewerken" : "Afgesloten project kan niet bewerkt worden")">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.Edit"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@OpenEditFormDialogAsync"
										           Disabled="@(!IsActive)">
											Aanpassen
										</MudButton>
									</MudTooltip>
								</MudStack>
								<MudText Typo="Typo.subtitle2">@_project.Name</MudText>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudText><b>Startdatum:</b> @(_project.StartDate)</MudText>
							<MudText><b>Einddatum:</b> @(_project.EndDate)</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Meetnet en zone *@
				<MudItem xs="12" md="6" Class="d-flex">
					<MudCard Elevation="2" Class="rounded-lg flex-grow-1">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">@_project.MeasurementNetwork.Name</MudText>
									<MudTooltip Delay="400"
									            Text="@(IsActive ? "Meetnet wijzigen" : "Afgesloten project kan niet bewerkt worden")">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.MyLocation"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           Disabled="@(!IsActive)"
										           OnClick="@OpenUpdateMeasurementDialogAsync">
											Wijzigen
										</MudButton>
									</MudTooltip>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudText><b>Zone:</b> @_project.MeasurementNetwork.Zone</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Measurement stations table *@
				<MudItem xs="12">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">Meetstations
									</MudText>
									<MudTooltip Delay="400"
									            Text="@(IsActive ? "Lijst van meetstations bewerken" : "Afgesloten project kan niet bewerkt worden")">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.PlaylistAdd"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@OpenDialogAsync"
										           Disabled="@(!IsActive)">
											Aanpassen
										</MudButton>
									</MudTooltip>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MeasurementStations ProjectId="ProjectId" Stations="_stationsFromProject"/>
						</MudCardContent>
					</MudCard>
				</MudItem>

			</MudGrid>
			break;
		case 1:
			<History ProjectId="ProjectId"/>
			break;
	}
}