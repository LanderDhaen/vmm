@page "/projects/{ProjectId:guid}"
@inject NavigationManager Navigation
<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:70vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudContainer MaxWidth="MaxWidth.Medium">
		<MudPaper Elevation="1">
			<MudTabs Border="false" Centered="true">
				<!-- INFO TAB -->
				<MudTabPanel Text="Informatie">
					<MudGrid Class="gap-3" Justify="Justify.Center">
						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="text-secondary">Referentienummer</MudText>
							<MudPaper Class="p-2 bg-white shadow-xs">@_project.Code</MudPaper>
						</MudItem>

						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="text-secondary">Site</MudText>
							<MudPaper Class="p-2 bg-white shadow-xs">@_project.Location.Name</MudPaper>
						</MudItem>

						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="text-secondary">Stad</MudText>
							<MudPaper
								Class="p-2 bg-white shadow-xs">@_project.Location.Address.PostalCode, @_project.Location.Address.City</MudPaper>
						</MudItem>

						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="text-secondary">Provincie</MudText>
							<MudPaper Class="p-2 bg-white shadow-xs">TODO</MudPaper>
						</MudItem>

						<MudItem xs="12" sm="6">
							<MudText Typo="Typo.subtitle2" Class="text-secondary">Regio</MudText>
							<MudPaper Class="p-2 bg-white shadow-xs">TODO</MudPaper>
						</MudItem>

						<MudItem xs="12">
							<MudText Typo="Typo.subtitle2" Class="text-secondary">Opmerkingen</MudText>
							<MudTextField
								@bind-Value="_remarks"
								FullWidth="true"
								Lines="4"
								Variant="Variant.Filled"
								Class="bg-white "
								Margin="Margin.Dense"
							/>
						</MudItem>
					</MudGrid>
				</MudTabPanel>

				<!-- MAP TAB -->
				<MudTabPanel Text="Kaart">
					<MudPaper Class="p-2 p-sm-3 rounded-sm bg-white" Elevation="0">
						<div style="width: 100%; height: 500px; border-radius: 4px; overflow: hidden;">
							<RealTimeMap Parameters="_parameters" height="500px" width="100%"></RealTimeMap>
						</div>
						<MudText Typo="Typo.caption" Class="text-center mt-2 text-secondary">
							@_project.Location.Coordinate.Y.ToString("F5") - @_project.Location.Coordinate.X.ToString("F5")
						</MudText>
					</MudPaper>
				</MudTabPanel>

				<!-- 📊 MEETSTATIONS -->
				<MudTabPanel Text="Meetstations">
					<MudText Typo="Typo.body1">[Lijst van meetstations]</MudText>
				</MudTabPanel>

				<!-- 🔙 HISTORY -->
				<MudTabPanel Text="..." OnClick="NavigateToHistory"></MudTabPanel>
			</MudTabs>

		</MudPaper>
	</MudContainer>
}