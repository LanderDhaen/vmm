@page "/projects/{ProjectId:guid}"
@using Rise.Shared.Projects
@using Rise.Shared.Stations
@inject NavigationManager Navigation
@attribute [Authorize]

<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudOverlay @bind-Visible="_visible" DarkBackground>
		<MudPaper Class="pa-6 mx-auto">
			<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
				<MudText Typo="Typo.h5">Lijst meetstations bewerken</MudText>
				<MudIconButton Icon="@Icons.Material.Filled.Close"
				               Size="Size.Medium"
				               OnClick="@(() => _visible = false)"/>
			</MudStack>

			<MudRadioGroup @bind-Value="_selectedOption">
				<MudRadio Value="@("Bestaand")">Bestaand meetstation toevoegen of verwijderen</MudRadio>
				<MudRadio Value="@("Nieuw")">Nieuw meetstation toevoegen</MudRadio>
			</MudRadioGroup>

			@if (_selectedOption == "Bestaand")
			{
				<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">
					<MudTextField T="string"
					              InputType="InputType.Search"
					              Label="Zoek"
					              Class="m-0"
					              Variant="Variant.Outlined"
					              DebounceInterval="300"
					              OnDebounceIntervalElapsed="HandleIntervalElapsed"
					              @bind-Value="_searchTerm"
					              Margin="Margin.Dense"
					              Adornment="Adornment.End"
					              AdornmentIcon="@Icons.Material.Filled.Search"/>
					<MudTooltip Delay="400"
					            Text="@(IsActive ? "Lijst van meetstations bewerken" : "Afgesloten project kan niet bewerkt worden")">
						<MudButton Variant="Variant.Filled"
						           StartIcon="@Icons.Material.Filled.PlaylistAdd"
						           Size="Size.Small"
						           Color="Color.Primary"
						           Class="px-4"
						           OnClick="@UpdateMeasurementStations" Disabled="@(!IsActive)">
							Lijst bijwerken
						</MudButton>
					</MudTooltip>
				</MudStack>

				<MudTable @ref="_table" T="MeasurementStationDto.Index" Items="@_allStations" MultiSelection="true"
				          SelectionChangeable="true" Hover="true"
				          @bind-SelectedItems="_stationsFromProject" SelectOnRowClick="false" CustomHeader="true"
				          Virtualize="true" FixedHeader="true">
					<HeaderContent>
						<MudTHeadRow>
							<MudTh Class="mud-theme-primary">#</MudTh>
							<MudTh Class="mud-theme-primary">Locatie</MudTh>
							<MudTh Class="mud-theme-primary">Gemeente</MudTh>
						</MudTHeadRow>
					</HeaderContent>
					<RowTemplate>
						<MudTd DataLabel="#">@context.Code</MudTd>
						<MudTd DataLabel="Locatie">@context.Location</MudTd>
						<MudTd DataLabel="Gemeente">@context.City</MudTd>
					</RowTemplate>
				</MudTable>
			}
			else if (_selectedOption == "Nieuw")
			{
			}
		</MudPaper>
	</MudOverlay>

	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudDrawer @bind-open="@_open" Anchor="Anchor.Right" Elevation="1" Variant="DrawerVariant.Temporary">
			<MudDrawerHeader>Acties</MudDrawerHeader>
			<MudButton StartIcon="@Icons.Material.Filled.Cancel"
			           Color="Color.Error"
			           OnClick="@ShowCloseConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Afgesloten)">
				Project afsluiten
			</MudButton>

			<MudButton StartIcon="@Icons.Material.Filled.Check"
			           Color="Color.Success"
			           OnClick="@ShowStartConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Actief)">
				Project opstarten
			</MudButton>
		</MudDrawer>
	</MudHidden>

	// Mobile
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<MudDrawer @bind-open="@_open" Anchor="Anchor.Bottom" Elevation="1" Variant="DrawerVariant.Temporary">
			<MudDrawerHeader>Acties</MudDrawerHeader>
			<MudButton StartIcon="@Icons.Material.Filled.Cancel"
			           Color="Color.Error"
			           OnClick="@ShowCloseConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Afgesloten)">
				Project afsluiten
			</MudButton>

			<MudButton StartIcon="@Icons.Material.Filled.Check"
			           Color="Color.Success"
			           OnClick="@ShowStartConfirmationAsync"
			           Disabled="@(_project?.Status == Status.Actief)">
				Project opstarten
			</MudButton>
		</MudDrawer>
	</MudHidden>

	@* Tabs *@
	<MudStack Row="true" Justify="Justify.FlexStart" Spacing="8">
		<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(0)">
			@_tabs[0]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
		         @onclick="async () => await SetTabAsync(1)">
			@_tabs[1]
		</MudText>
	</MudStack>

	@switch (_selectedTab)
	{
		case 0:
			<MudGrid Spacing="4" Class="mt-4">

				@* Details *@
				<MudItem xs="12" md="6">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">@_project.Code</MudText>
									<MudButton Variant="Variant.Text"
									           StartIcon="@Icons.Material.Filled.Edit"
									           Size="Size.Small"
									           Color="Color.Primary"
									           Class="px-4"
									           Href="@($"/projects/edit/{ProjectId}")">
										Aanpassen
									</MudButton>
								</MudStack>
								<MudText Typo="Typo.subtitle2">@_project.Name</MudText>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudText><b>Startdatum:</b> @(_project.StartDate)</MudText>
							<MudText><b>Einddatum:</b> @(_project.EndDate)</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Meetnet en zone *@
				<MudItem xs="12" md="6" Class="d-flex">
					<MudCard Elevation="2" Class="rounded-lg flex-grow-1">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">@_project.MeasurementNetwork.Name</MudText>
									<MudButton Variant="Variant.Text"
									           StartIcon="@Icons.Material.Filled.MyLocation"
									           Size="Size.Small"
									           Color="Color.Primary"
									           Class="px-4">
										Wijzigen
									</MudButton>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudText><b>Zone:</b> @_project.MeasurementNetwork.Zone</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Measurement stations table *@
				<MudItem xs="12">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">Lijst meetstations
									</MudText>
									<MudButton Variant="Variant.Filled"
									           StartIcon="@Icons.Material.Filled.PlaylistAdd"
									           Size="Size.Small"
									           Color="Color.Primary"
									           Class="px-4"
									           OnClick="@OpenOverlay">
										Lijst bijwerken
									</MudButton>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudTextField T="string"
							              InputType="InputType.Search"
							              Label="Zoek"
							              Class="m-0"
							              Variant="Variant.Outlined"
							              DebounceInterval="300"
							              OnDebounceIntervalElapsed="HandleIntervalElapsed"
							              @bind-Value="_searchTerm"
							              Margin="Margin.Dense"
							              Adornment="Adornment.End"
							              AdornmentIcon="@Icons.Material.Filled.Search"/>
							<MeasurementStations Stations="_stationsFromProject"/>
						</MudCardContent>
					</MudCard>
				</MudItem>

			</MudGrid>
			break;
		case 1:
			<History ProjectId="ProjectId"/>
			break;
	}
}