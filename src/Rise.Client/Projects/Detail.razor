@page "/projects/{ProjectId:guid}"
@using Rise.Shared.Projects

<PageTitle>Project Details</PageTitle>

@if (_project is null) {
    <MudProgressCircular Indeterminate="true"/>
} else {
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h4" Class="mb-4">@_project.Name</MudText>
        
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6">Code</MudText>
                <MudText>@_project.Code</MudText>
            </MudItem>
            
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h6">Periode</MudText>
                @* <MudText>@_project.DateRange.StartDate.ToShortDateString() - @_project.DateRange.EndDate.ToShortDateString()</MudText> *@
            </MudItem>
            
            <MudItem xs="12">
                <MudText Typo="Typo.h6">Locatie</MudText>
                <MudText>@_project.Location.Name</MudText>
                <MudText>@_project.Location.Address.AddressLine1, @_project.Location.Address.AddressLine2</MudText>
                <MudText>@_project.Location.Address.City, @_project.Location.Address.PostalCode - @_project.Location.Address.CountryIso</MudText>
                <MudText>Coördinaten: @_project.Location.Coordinate.X, @_project.Location.Coordinate.Y</MudText>
            </MudItem>
        </MudGrid>
        
        <MudButton Href="/projects" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Terug</MudButton>
    </MudPaper>
}