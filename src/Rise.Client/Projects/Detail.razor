@page "/projects/{ProjectId:guid}"
@using Rise.Client.Components
@inject NavigationManager Navigation
<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:70vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	if (false)
	{
//mobile & desktop different layout OR use breakpoints
	}
	else
	{
		<MudContainer>
			<MudBreadcrumbs Items="_items">
				<SeparatorTemplate>
					<MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
				</SeparatorTemplate>
			</MudBreadcrumbs>

		
			@* Mobile *@
			<ArrowHeader Title="Site" OnBack="NavigateToProjects" Class="m-4"/>
			<MudTabs Border="false">
				<!-- INFO TAB -->
				<MudTabPanel Text="Info">
					<div class="d-flex align-center mt-2 mb-2">
						<MudText Class="p-2" Typo="Typo.h5">@_project.Name</MudText>
						<MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"></MudIcon>
					</div>
					<MudStack>
						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
							<MudPaper Class="p-2">@_project.Code</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Naam</MudText>
							<MudPaper Class="p-2">@_project.Name</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Start datum</MudText>
							<MudPaper Class="p-2">@_project.StartDate</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Eind datum</MudText>
							<MudPaper Class="p-2">@_project.EndDate</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Meetnet</MudText>
							<MudPaper Class="p-2">@_project.MeasurementNetwork</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Zone</MudText>
							<MudPaper Class="p-2">@_project.Zone</MudPaper>
						</MudItem>

						<MudItem Class="m-2">
							<MudText Typo="Typo.subtitle2">Opmerkingen</MudText>
							<MudTextField
								@bind-Value="_remarks"
								FullWidth="true"
								Lines="4"
								Class="white"/>
						</MudItem>
					</MudStack>
				</MudTabPanel>

				@* <!-- MAP TAB --> *@
				@* <MudTabPanel Text="Kaart"> *@
				@* 	<MudContainer Class="pa-4"> *@
				@* 		<MudStack Justify="Justify.Center"> *@
				@* 			<MudItem> *@
				@* 				<MudText Typo="Typo.subtitle2" Class="text-secondary">Breedtegraad</MudText> *@
				@* 				<MudPaper *@
				@* 					Class="p-2 "> @_project.Location.Coordinate.Y.ToString("F5") *@
				@* 				</MudPaper> *@
				@* 			</MudItem> *@
				@* *@
				@* 			<MudItem> *@
				@* 				<MudText Typo="Typo.subtitle2" Class="text-secondary">Lengtegraad</MudText> *@
				@* 				<MudPaper *@
				@* 					Class="p-2"> @_project.Location.Coordinate.X.ToString("F5") *@
				@* 				</MudPaper> *@
				@* 			</MudItem> *@
				@* 		</MudStack> *@
				@* 	</MudContainer> *@
				@* 	<MudContainer Class="p-4"> *@
				@* 		<MudPaper> *@
				@* 			<div style="width: 100%; height: 400px; border-radius: 4px; overflow: hidden;"> *@
				@* 				<RealTimeMap Parameters="_parameters" height="400px" width="100%"></RealTimeMap> *@
				@* 			</div> *@
				@* 		</MudPaper> *@
				@* 	</MudContainer> *@
				@* *@
				@* </MudTabPanel> *@

				<!-- MEETSTATIONS -->
				<MudTabPanel Text="Meetstations">
					<MudText Typo="Typo.body1">[Lijst van meetstations]</MudText>
				</MudTabPanel>

				<!-- HISTORY -->
				<MudTabPanel Text="Historiek" OnClick="NavigateToHistory"></MudTabPanel>
			</MudTabs>

			<MudButton Icon="@Icons.Material.Filled.MoreHoriz" OnClick="NavigateToHistory"/>
		</MudContainer>
	}
}