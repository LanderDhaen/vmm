@page "/projects/{ProjectId:guid}"
@using Rise.Client.Components.Projects
@using Rise.Shared.Projects
@inject NavigationManager Navigation

<PageTitle>Project Details</PageTitle>

@if (_project is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	@* Tabs *@
	<MudStack Class="pt-2" Row="true" Justify="Justify.FlexStart" Spacing="6">
		<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
		         @onclick="() =>  SetTab(0)">
			@_tabs[0]
		</MudText>

		<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
		         @onclick="() =>  SetTab(1)">
			@_tabs[1]
		</MudText>
	</MudStack>

	@switch (_selectedTab)
	{
		case 0:

			@* Toolbar *@
			<MudStack Row="true" Justify="Justify.FlexEnd">
				@if (_project.Status.Equals(Status.Afgesloten))
				{
					<MudButton StartIcon="@Icons.Material.Filled.RestartAlt" Size="Size.Small"
					           Variant="Variant.Filled" Color="Color.Warning"
					           OnClick="@ShowStartConfirmationAsync">
						Heropstarten
					</MudButton>
				}
				else
				{
					<MudButton StartIcon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Filled"
					           Color="Color.Error"
					           OnClick="@ShowCloseConfirmationAsync">Afsluiten
					</MudButton>
				}
			</MudStack>

			<MudGrid Spacing="4" Class="mt-2">
				@* Details *@
				<MudItem xs="12" md="6">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">@_project.Code</MudText>
									<MudTooltip Delay="600"
									            Text="@(IsActive ? "Project bewerken" : "Afgesloten project kan niet bewerkt worden")">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.Edit"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@OpenEditFormDialogAsync"
										           Disabled="@(!IsActive)">
											Aanpassen
										</MudButton>
									</MudTooltip>
								</MudStack>
								<MudText Typo="Typo.subtitle2">@_project.Name</MudText>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">
								<MudText><b>Status: </b></MudText>
								<ProjectStatusChip Status="_project.Status"/>
							</MudStack>
							<MudText><b>Startdatum:</b> @ProjectUtility.ToLongStartDate(_project.StartDate)</MudText>
							<MudText><b>Einddatum:</b> @ProjectUtility.ToLongEndDate(_project.EndDate)</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Meetnet en zone *@
				<MudItem xs="12" md="6" Class="d-flex">
					<MudCard Elevation="2" Class="rounded-lg flex-grow-1">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">Meetnet
									</MudText>
									<MudTooltip Delay="600"
									            Text="@(IsActive ? "Meetnet wijzigen" : "Afgesloten project kan niet bewerkt worden")">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.MyLocation"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           Disabled="@(!IsActive)"
										           OnClick="@OpenUpdateMeasurementDialogAsync">
											Wijzigen
										</MudButton>
									</MudTooltip>
								</MudStack>
								<MudText Typo="Typo.subtitle2">@_project.MeasurementNetwork.Name</MudText>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MudText><b>Zone:</b> @_project.MeasurementNetwork.Zone</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				@* Measurement stations table *@
				<MudItem xs="12">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6"
									         Color="Color.Primary">Meetstations
									</MudText>
									<MudTooltip
										Text="@(IsActive ? "Lijst bewerken" : "Afgesloten project kan niet bewerkt worden")"
										Delay="600" Placement="Placement.Top">
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.PlaylistAdd"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@OpenDialogAsync"
										           Disabled="@(!IsActive)">
											Aanpassen
										</MudButton>
									</MudTooltip>
								</MudStack>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent>
							<MeasurementStations ProjectId="ProjectId" Stations="_stationsFromProject"/>
						</MudCardContent>
					</MudCard>
				</MudItem>
			</MudGrid>
			break;
		case 1:
			<History ProjectId="ProjectId"/>
			break;
	}
}