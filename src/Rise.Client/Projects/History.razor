@using Rise.Client.Components
@using Rise.Shared.Projects

<PageTitle>Project Details</PageTitle>

@if (_project is null) {
    <MudContainer Class="d-flex justify-center align-center">
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
    </MudContainer>
} 
else {

    <MudButton Variant="Variant.Filled"
               Size="Size.Small"
               StartIcon="@(displayTable ? Icons.Material.Filled.Timeline : Icons.Material.Filled.TableRows)"
               Color="Color.Primary"
               OnClick="@(() => displayTable = !displayTable)">
        @(displayTable ? "Tijdslijn" : "Tabel")
    </MudButton>
	
    @* TODO: Switch to simple table + current values *@
    
    @if (displayTable)
    {
	    <MudDataGrid T="ProjectHistoryDto.Index"
	                 Items="_project.ProjectHistories"
	                 RowsPerPage="10"
	                 Striped="true"
	                 SortMode="SortMode.None">

		    <Columns>
			    <PropertyColumn Property="x => x.StartDate" Title="Startdatum" HeaderClass="mud-theme-primary"/>
			    <PropertyColumn Property="x => x.EndDate" Title="Einddatum" HeaderClass="mud-theme-primary"/>
			    <PropertyColumn Property="x => x.ValidTo" Title="Geldig van" HeaderClass="mud-theme-primary"/>
			    <PropertyColumn Property="x => x.ValidFrom" Title="Geldig tot" HeaderClass="mud-theme-primary"/>
		    </Columns>

		    <PagerContent>
			    <Pagination T="ProjectHistoryDto.Index"/>
		    </PagerContent>
	    </MudDataGrid>
    } else {
	    <MudTimeline>
		    <MudTimelineItem Color="Color.Primary">
			    <ItemOpposite>
				    <MudText>Huidig project</MudText>
			    </ItemOpposite>
			    <ItemContent>
				    <MudText Typo="Typo.h6">@_project.Code - @_project.Name</MudText>
				    <MudText>Startdatum: @_project.StartDate</MudText>
				    <MudText>Einddatum: @_project.EndDate</MudText>
			    </ItemContent>
		    </MudTimelineItem>
		    
		    @foreach (var h in _project.ProjectHistories)
		    {
			    <MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
				    <ItemOpposite>
					    @h.ValidFrom - @h.ValidTo
				    </ItemOpposite>
				    <ItemContent>
					    <MudText Typo="Typo.h6">@_project.Code - @_project.Name</MudText>
					    <MudText>Startdatum: @h.StartDate</MudText>
					    <MudText>Einddatum: @h.EndDate</MudText>
				    </ItemContent>
			    </MudTimelineItem>
		    }

	    </MudTimeline>

    }
}
