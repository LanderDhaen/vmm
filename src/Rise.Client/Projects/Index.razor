@page "/projects"
@using Rise.Client.Components
@using Rise.Shared.Projects
@attribute [Authorize]
<PageTitle>Projecten</PageTitle>

<MudContainer>
	<ToolBar OnSortClicked="OpenSortOptionsAsync" />
	<MudHidden Breakpoint="Breakpoint.Xs">
		<MudDataGrid T="ProjectDto.Index"
		             ServerData="GetProjectsAsync"
		             RowsPerPage="10"
		             Striped="true"
		             Hover="true"
		             RowClick="OnRowClick">

			<Columns>
				<PropertyColumn Property="x => x.Code" Title="#" HeaderClass="mud-theme-primary" />
				<PropertyColumn Property="x => x.Name" Title="Naam" HeaderClass="mud-theme-primary" />
				<PropertyColumn Property="x => x.StartDate" Title="Startdatum" HeaderClass="mud-theme-primary" />
				<PropertyColumn Property="x => x.EndDate" Title="Einddatum" HeaderClass="mud-theme-primary" />
				<PropertyColumn Property="x => x.MeasurementNetwork" Title="Meetnet" HeaderClass="mud-theme-primary" />
				<PropertyColumn Property="x => x.Zone" Title="Zone" HeaderClass="mud-theme-primary" />
			</Columns>
		</MudDataGrid>
	</MudHidden>
	<MudHidden Breakpoint="Breakpoint.SmAndUp">
		<MudGrid Spacing="4">
			@if (_mobileItems is null)
			{
				<MudItem xs="12">
					<div>
						<MudProgressCircular Indeterminate="true" />
					</div>
				</MudItem>
			}
			else if (!_mobileItems.Any())
			{
				<MudItem xs="12">
					<MudText>Geen projecten</MudText>
				</MudItem>
			}
			else
			{
				@foreach (var item in _mobileItems)
				{
					<MudItem xs="12">
						<MudCard
							Elevation="2"
							Class="rounded-lg"
							@onclick="() => NavigateToProject(item.Id)">
							<MudCardContent>
								<MudText Typo="Typo.h6">@item.Name</MudText>

								<MudText Typo="Typo.caption">
									<b>Code:</b> @item.Code<br />
									<b>Zone:</b> @item.Zone<br />
									<b>Status:</b> @item.Status<br />
									<b>Start datum:</b> @(item.StartDate.ToString("dd/MM/yyyy"))<br />
									<b>Eind datum:</b> @(item.StartDate.ToString("dd/MM/yyyy"))<br />
									<b>Meetnet:</b> @item.MeasurementNetwork
								</MudText>
							</MudCardContent>
						</MudCard>
					</MudItem>
				}
			}
		</MudGrid>
		<MudDrawer Anchor="Anchor.Bottom"
		           Variant="DrawerVariant.Temporary"
		           Elevation="8"
		           @bind-Open="_mobileSortOptionsOpen"
		           DisableOverlay="false"
		           Class="p-4"
		           Style="max-height:70vh; overflow-y:auto; border-radius:16px 16px 0 0;">
			<MudStack Spacing="2">
				<MudText Typo="Typo.h6">Sorteren</MudText>
				<MudDivider />

				<MudText Typo="Typo.subtitle2">Projectcode</MudText>
				<MudStack Row="true" Spacing="1">
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Code, false))">
						A → Z
					</MudButton>
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Code, true))">
						Z → A
					</MudButton>
				</MudStack>

				<MudText Typo="Typo.subtitle2">Projectnaam</MudText>
				<MudStack Row="true" Spacing="1">
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Name, false))">
						A → Z
					</MudButton>
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Name, true))">
						Z → A
					</MudButton>
				</MudStack>

				<MudText Typo="Typo.subtitle2">Startdatum</MudText>
				<MudStack Row="true" Spacing="1">
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.StartDate, false))">
						Oud → Nieuw
					</MudButton>
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.StartDate, true))">
						Nieuw → Oud
					</MudButton>
				</MudStack>

				<MudText Typo="Typo.subtitle2">Einddatum</MudText>
				<MudStack Row="true" Spacing="1">
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.EndDate, false))">
						Oud → Nieuw
					</MudButton>
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.EndDate, true))">
						Nieuw → Oud
					</MudButton>
				</MudStack>

				<MudText Typo="Typo.subtitle2">Meetnet</MudText>
				<MudStack Row="true" Spacing="1">
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.MeasurementNetwork, false))">
						A → Z
					</MudButton>
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.MeasurementNetwork, true))">
						Z → A
					</MudButton>
				</MudStack>

				<MudText Typo="Typo.subtitle2">Zone</MudText>
				<MudStack Row="true" Spacing="1">
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Zone, false))">
						A → Z
					</MudButton>
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Zone, true))">
						Z → A
					</MudButton>
				</MudStack>

				<MudText Typo="Typo.subtitle2">Status</MudText>
				<MudStack Row="true" Spacing="1">
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Status, false))">
						A → Z
					</MudButton>
					<MudButton Variant="Variant.Outlined"
					           OnClick="@(() => SortMobileAsync(MobileProjectSortColumn.Status, true))">
						Z → A
					</MudButton>
				</MudStack>

				<MudDivider Class="mt-4" />
				<MudButton Variant="Variant.Text"
				           Color="Color.Secondary"
				           OnClick="@(() => _mobileSortOptionsOpen = false)">
					Sluiten
				</MudButton>
			</MudStack>
		</MudDrawer>
	</MudHidden>
	@* </MudPaper> *@
</MudContainer>
