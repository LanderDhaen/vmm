@page "/projects"
@using Rise.Client.Components
@using Rise.Shared.Projects
@using Rise.Shared.Common
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<PageTitle>Projecten</PageTitle>

@* Desktop view *@
<MudHidden Breakpoint="Breakpoint.Xs">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">

        <MudTextField T="string"
                      Label="Zoek"
                      Class="m-0"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      DebounceInterval="1000"
                      OnDebounceIntervalElapsed="HandleDesktopIntervalElapsed"
                      @bind-Value="_searchTerm"
                      FullWidth="true"
                      Margin="Margin.Dense"/>

        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.FilterAlt"
                   Color="Color.Primary"
                   Class="px-4"
                   OnClick="@ToggleFiltersDrawer">
            Filteren
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   Color="Color.Primary"
                   Class="px-4"
                   OnClick="@NavigateToCreate">
            Project
        </MudButton>
    </MudStack>

    <MudDataGrid T="ProjectDto.Index"
                 ServerData="GetProjectsAsync"
                 RowsPerPage="10"
                 Striped="true"
                 Hover="true"
                 RowClick="@(args => NavigateToProject(args.Item.Id))"
                 @ref="_grid">

        <Columns>
            <PropertyColumn Property="x => x.Code" Title="#" HeaderClass="mud-theme-primary"/>
            <PropertyColumn Property="x => x.Name" Title="Naam" HeaderClass="mud-theme-primary"/>
            <PropertyColumn Property="x => x.StartDate" Title="Startdatum" HeaderClass="mud-theme-primary"/>
            <PropertyColumn Property="x => x.EndDate" Title="Einddatum" HeaderClass="mud-theme-primary"/>
            <PropertyColumn Property="x => x.MeasurementNetwork" Title="Meetnet" HeaderClass="mud-theme-primary"/>
            <PropertyColumn Property="x => x.Zone" Title="Zone" HeaderClass="mud-theme-primary"/>
        </Columns>

        <PagerContent>
            <Pagination T="ProjectDto.Index"></Pagination>
        </PagerContent>

    </MudDataGrid>
</MudHidden>

@* Mobile view *@
<MudHidden Breakpoint="Breakpoint.SmAndUp">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-4">

        <MudTextField T="string"
                      Label="Zoek"
                      Class="m-0"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      DebounceInterval="1000"
                      OnDebounceIntervalElapsed="HandleMobileIntervalElapsed"
                      @bind-Value="_searchTerm"
                      FullWidth="true"
                      Margin="Margin.Dense"/>

        <MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="@ToggleSortingDrawer"/>

        <MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="@ToggleFiltersDrawer"/>

        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="@NavigateToCreate"/>
    </MudStack>

    <MudGrid Spacing="4">
        @if (_mobileItems is null)
        {
            <MudItem xs="12">
                <div>
                    <MudProgressCircular Indeterminate="true"/>
                </div>
            </MudItem>
        }
        else if (!_mobileItems.Any())
        {
            <MudItem xs="12">
                <MudText>Geen projecten</MudText>
            </MudItem>
        }
        else
        {
            @foreach (var item in _mobileItems)
            {
                <MudItem xs="12">
                    <MudCard Elevation="2"
                             Class="rounded-lg"
                             @onclick="() => NavigateToProject(item.Id)">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>@item.Code</b></MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@(DefineColor(item.Status))">@item.Status</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.h6">@item.Name</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pt-0">
                            <MudText Typo="Typo.subtitle1"><b>Start datum:</b> @item.StartDate</MudText>
                            <MudText Typo="Typo.subtitle1"><b>Eind datum:</b> @item.EndDate</MudText>
                            <MudText Typo="Typo.subtitle1"><b>Meetnet:</b> @item.MeasurementNetwork</MudText>
                            <MudText Typo="Typo.subtitle1"><b>Zone:</b> @item.Zone</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>
</MudHidden>

@* Sort drawer (mobile) *@
@if (_mobileSortOptionsOpen)
{
    <MudDrawer Anchor="Anchor.Bottom"
               Variant="DrawerVariant.Temporary"
               Elevation="8"
               @bind-Open="_mobileSortOptionsOpen"
               Class="p-4 rounded-lg">

        <MudText Typo="Typo.h6">Sorteren</MudText>

        <MudStack Spacing="4">
            <MudDivider/>

            @foreach (var column in SortColumns)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudText>@column.Label</MudText>
                    <MudSpacer/>

                    <MudButton
                        Variant="@(_activeSorting == column.Value && !_activeSortingDesc ? Variant.Filled : Variant.Outlined)"
                        Color="@(_activeSorting == column.Value && !_activeSortingDesc ? Color.Primary : Color.Default)"
                        Size="Size.Small"
                        OnClick="@(() => SortMobileAsync(column.Value, false))">
                        Oplopend
                    </MudButton>

                    <MudButton
                        Variant="@(_activeSorting == column.Value && _activeSortingDesc ? Variant.Filled : Variant.Outlined)"
                        Color="@(_activeSorting == column.Value && _activeSortingDesc ? Color.Primary : Color.Default)"
                        Size="Size.Small"
                        OnClick="@(() => SortMobileAsync(column.Value, true))">
                        Aflopend
                    </MudButton>
                </MudStack>
            }

            <MudDivider/>

            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       OnClick="@ToggleSortingDrawer">
                Sluiten
            </MudButton>
        </MudStack>
    </MudDrawer>
}

@* Filter drawer (adaptive anchor: right on large screens, bottom on xs) *@
@if (_filterOptionsOpen)
{
    <MudDrawer Anchor="@_filterDrawerAnchor"
               Variant="DrawerVariant.Temporary"
               Elevation="8"
               @bind-Open="_filterOptionsOpen"
               Class="p-4 rounded-lg">

        <MudText Typo="Typo.h6">Filteren</MudText>

        <MudStack Spacing="3" Class="mt-2">
            <MudDivider/>

            <MudSelect T="Status?" Label="Status" @bind-Value="_filterStatus" Dense="true" Clearable="true">
                @foreach (var s in Enum.GetValues(typeof(Status)).Cast<Status>())
                {
                    <MudSelectItem T="Status?" Value="@( (Status?) s )">@s</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" Label="Zone" @bind-Value="_filterZone" Dense="true" Clearable="true" Placeholder="Selecteer...">
                @foreach (var z in _zones)
                {
                    <MudSelectItem T="string" Value="@z">@z</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string" Label="Meetnet" @bind-Value="_filterMeasurementNetwork" Dense="true" Clearable="true" Placeholder="Selecteer...">
                @foreach (var m in _measurementNetworks)
                {
                    <MudSelectItem T="string" Value="@m">@m</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker T="DateTime?" Label="Startdatum (vanaf)" @bind-Date="_filterStartDate" DisableToolbar="true" Clearable="true" PickerVariant="PickerVariant.Inline" />

            <MudDatePicker T="DateTime?" Label="Einddatum (t.e.m.)" @bind-Date="_filterEndDate" DisableToolbar="true" Clearable="true" PickerVariant="PickerVariant.Inline" />

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="pt-2">
                <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@ClearFilters">Wissen</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ApplyFiltersAsync">Toepassen</MudButton>
            </MudStack>

        </MudStack>
    </MudDrawer>
}