@using Rise.Client.Components
@using Rise.Shared.Projects
@page "/projects"

<PageTitle>Projects</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="projects-container">

    <!-- Header -->
    <MudPaper Elevation="1" Class="projects-header pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="fw-600">Projects</MudText>
        <MudText Typo="Typo.subtitle2" Class="text-muted">
            Overview of all projects in the system.
        </MudText>
    </MudPaper>

    <!-- Projects Grid -->
    <MudPaper Elevation="2" Class="pa-4">
	    <MudDataGrid T="ProjectDto.Index"
	                 ServerData="GetProjectsAsync"
	                 RowsPerPage="5"
	                 Bordered="false"
	                 Hover="true"
	                 Dense="true"
	                 Elevation="0">
		    
		    <!-- ToolBar -->
		    
		    <ToolBarContent>
			    <ToolBar />
		    </ToolBarContent>
		    
		    <!-- Table -->

		    <Columns>
			    <PropertyColumn Property="x => x.Code" Title="#"/>
			    <PropertyColumn Property="x => x.Name" Title="Naam"/>
			    <PropertyColumn Property="x => x.DateRange.StartDate" Title="Startdatum" />
			    <PropertyColumn Property="x => x.DateRange.EndDate" Title="Einddatum" />
		    </Columns>

		    <!-- Pagination -->
		    
		    <PagerContent>
			   <Pagination T="ProjectDto.Index" />
		    </PagerContent>

	    </MudDataGrid>
    </MudPaper>
</MudContainer>

<style>
.projects-container {
    background-color: var(--mud-palette-background, #f5f5f5);
    min-height: 100vh;
    padding-top: 2rem;
    padding-bottom: 2rem;
}

.projects-header {
    border-radius: 12px;
    background-color: var(--mud-palette-surface, #ffffff);
    box-shadow: var(--mud-elevation-2, 0 2px 6px rgba(0,0,0,0.1));
}


.mud-datagrid thead {
    background-color: color-mix(in srgb, var(--mud-palette-primary, #3f51b5) 8%, var(--mud-palette-surface, #fff) 92%);
}

.text-muted {
    color: var(--mud-palette-text-secondary, #777);
}

.fw-600 {
    font-weight: 600;
}
</style>
