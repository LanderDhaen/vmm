@page "/projects"
@using Rise.Shared.Projects

<PageTitle>Projects</PageTitle>

	<MudDataGrid T="ProjectDto.Index" ServerData="GetProjectsAsync">
		<Columns>
			<PropertyColumn Property="x => x.Name" Title="Naam"/>
			<PropertyColumn Property="x => x.Code" Title="Referentienummer"/>
			<PropertyColumn Property="x => x.StartDate" Title="Begindatum"/>
			<PropertyColumn Property="x => x.EndDate" Title="Einddatum"/>
		</Columns>
		<PagerContent>
			<MudDataGridPager PageSizeOptions="new int[]{1, 2, 5, 10, 25, 50}"
			                  RowsPerPageString="Rijen per pagina"
			                  InfoFormat="{first_item}-{last_item} van de {all_items}"/>
		</PagerContent>
	</MudDataGrid>