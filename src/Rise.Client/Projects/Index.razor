@page "/projects"
@using Rise.Shared.Identity

<PageTitle>Projects</PageTitle>

@if (projects == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <MudDataGrid Items=projects>
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="Id" />
            <PropertyColumn Property="x => x.Name" />
        </Columns>
    </MudDataGrid>
}
