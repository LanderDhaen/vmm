@page "/projects"
@using Rise.Client.Components
@using Rise.Client.Components.Projects
@using Rise.Shared.Projects
@using Rise.Shared.Networks
@using Rise.Shared.Zones
<PageTitle>Projecten</PageTitle>

@* Desktop view *@
<MudHidden Breakpoint="Breakpoint.Xs">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              DebounceInterval="300"
		              OnDebounceIntervalElapsed="HandleDesktopIntervalElapsed"
		              @bind-Value="_searchTerm"
		              Margin="Margin.Dense"/>
		<MudButton Variant="Variant.Filled"
		           Size="Size.Small"
		           StartIcon="@Icons.Material.Filled.FilterAlt"
		           Color="Color.Primary"
		           Class="px-4"
		           OnClick="@ToggleFiltersDrawer">
			Filteren
		</MudButton>
		<MudButton Variant="Variant.Filled"
		           StartIcon="@Icons.Material.Filled.Add"
		           Size="Size.Small"
		           Color="Color.Primary"
		           Class="px-4"
		           OnClick="@NavigateToCreate">
			Project
		</MudButton>
	</MudStack>

	<MudDataGrid T="ProjectDto.Index"
	             ServerData="GetProjectsAsync"
	             @ref="_grid"
	             RowsPerPage="10"
	             Striped="true"
	             Hover="true"
	             SortMode="SortMode.Single"
	             AllowUnsorted="false"
	             ShowColumnOptions="false"
	             RowClass=""
	             RowClick="@(args => NavigateToProject(args.Item.Id))">

		<Columns>
			<PropertyColumn Property="x => x.Code" InitialDirection="SortDirection.Descending" Title="#"
			                HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Name" Title="Naam" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.StartDate" Title="Startdatum" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.EndDate" Title="Einddatum" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Status" Title="Status" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					<ProjectStatusChip Status="context.Item.Status"/>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.MeasurementNetwork" Title="Meetnet" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Zone" Title="Zone" HeaderClass="mud-theme-primary"/>
		</Columns>

		<PagerContent>
			<Pagination T="ProjectDto.Index"></Pagination>
		</PagerContent>

	</MudDataGrid>
</MudHidden>

@* Mobile view *@
<MudHidden Breakpoint="Breakpoint.SmAndUp">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              DebounceInterval="300"
		              OnDebounceIntervalElapsed="HandleMobileIntervalElapsed"
		              @bind-Value="_searchTerm"
		              FullWidth="true"
		              Margin="Margin.Dense"/>

		<MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha"
		               Color="Color.Primary"
		               Size="Size.Small"
		               OnClick="@ToggleSortingDrawer"/>

		<MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
		               Color="Color.Primary"
		               Size="Size.Small"
		               OnClick="@ToggleFiltersDrawer"/>

		<MudIconButton Icon="@Icons.Material.Filled.Add"
		               Color="Color.Primary"
		               Size="Size.Small"
		               OnClick="@NavigateToCreate"/>
	</MudStack>

	<MudGrid Spacing="4">
		@if (_mobileItems is null)
		{
			<MudItem xs="12">
				<div>
					<MudProgressCircular Indeterminate="true"/>
				</div>
			</MudItem>
		}
		else if (!_mobileItems.Any())
		{
			<MudItem xs="12">
				<MudText>Geen projecten</MudText>
			</MudItem>
		}
		else
		{
			@foreach (var item in _mobileItems)
			{
				<MudItem xs="12">
					<ProjectCard Project="item" />
				</MudItem>
			}
		}
	</MudGrid>
</MudHidden>

@* Sort drawer (mobile) *@
@if (_mobileSortOptionsOpen)
{
	<MudDrawer Anchor="Anchor.Bottom"
	           Variant="DrawerVariant.Temporary"
	           Elevation="8"
	           @bind-Open="_mobileSortOptionsOpen"
	           Class="pa-4 rounded-lg">

		<MudText Typo="Typo.h6">Sorteren</MudText>

		<MudStack Spacing="4">
			<MudDivider/>

			@foreach (var column in SortColumns)
			{
				<MudStack Row="true" AlignItems="AlignItems.Center">
					<MudText>@column.Label</MudText>
					<MudSpacer/>

					<MudButton
						Variant="@(_activeSorting == column.Value && !_activeSortingDesc ? Variant.Filled : Variant.Outlined)"
						Color="@(_activeSorting == column.Value && !_activeSortingDesc ? Color.Primary : Color.Default)"
						Size="Size.Small"
						OnClick="@(() => SortMobileAsync(column.Value, false))">
						Oplopend
					</MudButton>

					<MudButton
						Variant="@(_activeSorting == column.Value && _activeSortingDesc ? Variant.Filled : Variant.Outlined)"
						Color="@(_activeSorting == column.Value && _activeSortingDesc ? Color.Primary : Color.Default)"
						Size="Size.Small"
						OnClick="@(() => SortMobileAsync(column.Value, true))">
						Aflopend
					</MudButton>
				</MudStack>
			}

			<MudDivider/>

			<MudButton Variant="Variant.Text"
			           Color="Color.Primary"
			           OnClick="@ToggleSortingDrawer">
				Sluiten
			</MudButton>
		</MudStack>
	</MudDrawer>
}

@* Filter drawer (adaptive anchor: right on large screens, bottom on xs) *@
@if (_filterOptionsOpen)
{
	<MudDrawer Anchor="@_filterDrawerAnchor"
	           Variant="DrawerVariant.Temporary"
	           Elevation="8"
	           @bind-Open="_filterOptionsOpen"
	           Class="@GetFilterDrawerClass()">

		<MudText Typo="Typo.h6" Color="Color.Primary">Filteren</MudText>

		<MudStack Spacing="3" Class="mt-2">
			<MudDivider/>

			<MudSelect T="Status?"
			           Label="Status"
			           Value="_filterStatus"
                 ValueChanged="@(async val => { _filterStatus = val; await ApplyOrReloadOnChangeAsync(); })"
			           Dense="true"
			           Clearable="true">
				@foreach (var s in Enum.GetValues(typeof(Status)).Cast<Status>())
				{
					<MudSelectItem T="Status?" Value="@((Status?)s)">@s</MudSelectItem>
				}
			</MudSelect>

			<MudSelect T="string" Label="Zone" Value="_filterZone"
			           ValueChanged="@(async val => { _filterZone = val; await ApplyOrReloadOnChangeAsync(); })"
			           Dense="true" Clearable="true" Placeholder="Selecteer..."
			           OnOpen="HandleZoneSelectOpen">
				@if (_zones == null)
				{
					<MudSelectItem T="string" Disabled="true">Laden...</MudSelectItem>
				}
				else
				{
					@foreach (var z in _zones)
					{
						<MudSelectItem T="string" Value="@z.Name">@z.Name</MudSelectItem>
					}
				}
			</MudSelect>

			<MudSelect T="string" Label="Meetnet" Value="_filterMeasurementNetwork"
			           ValueChanged="@(async val => { _filterMeasurementNetwork = val; await ApplyOrReloadOnChangeAsync(); })"
			           Dense="true" Clearable="true" Placeholder="Selecteer..."
			           OnOpen="HandleNetworkSelectOpen">
				@if (_measurementNetworks == null)
				{
					<MudSelectItem T="string" Disabled="true">Laden...</MudSelectItem>
				}
				else
				{
					@foreach (var m in _measurementNetworks)
					{
						<MudSelectItem T="string" Value="@m.Name">@m.Name</MudSelectItem>
					}
				}
			</MudSelect>

			<MudDatePicker T="DateTime?" Label="Startdatum (vanaf)" Date="_filterStartDate"
               DateChanged="@(async val => {
                   _filterStartDate = val;
                   if (_filterStartDate.HasValue && _filterEndDate.HasValue && _filterEndDate.Value <= _filterStartDate.Value)
                   {
                       _filterEndDate = null;
                   }
                   await ApplyOrReloadOnChangeAsync();
                   })"
			                Clearable="true" PickerVariant="PickerVariant.Dialog"/>

			<MudDatePicker T="DateTime?" Label="Einddatum (t.e.m.)" Date="_filterEndDate"
                     DateChanged="@(async val => { _filterEndDate = val; await ApplyOrReloadOnChangeAsync(); })"
			               Clearable="true" PickerVariant="PickerVariant.Dialog"
			               MinDate="_filterStartDate?.AddDays(1)"/>

			<MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="pt-2">
				<MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@ClearFilters">Wissen</MudButton>
			</MudStack>

		</MudStack>
	</MudDrawer>
}