@page "/projects/edit/{ProjectId:guid}"
@attribute [Authorize]

@if (Model is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudText Class="my-4" Typo="Typo.h3">Bewerk project</MudText>
	<MudCard>
		<MudForm Model="@Model" @ref="form" Validation="_validator.ValidateValue" ValidationDelay="0">
			<MudCardContent>
				<MudGrid>
					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Referentienummer</MudText>
						<MudTextField @bind-Value="Model.Code" For="@(() => Model.Code)" Counter="50" MaxLength="50"
						              Immediate="true" Variant="Variant.Outlined" Placeholder="Referentienummer"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Naam</MudText>
						<MudTextField @bind-Value="Model.Name" For="@(() => Model.Name)" Counter="250" MaxLength="250"
						              Immediate="true" Variant="Variant.Outlined" Placeholder="Naam"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Start datum</MudText>
						<MudDatePicker @bind-Date="Model.StartDate" For="@(() => Model.StartDate)"
						               DateFormat="dd/MM/yyyy"
						               Variant="Variant.Outlined"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Eind datum</MudText>
						<MudDatePicker @bind-Date="Model.EndDate" For="@(() => Model.EndDate)" DateFormat="dd/MM/yyyy"
						               Variant="Variant.Outlined"/>
					</MudItem>

					<MudItem xs="12" sm="6">
						<MudText Typo="Typo.subtitle2">Meetnet</MudText>
						<MudSelect T="Guid?" @bind-Value="Model.MeasurementNetworkId"
						           For="@(() => Model.MeasurementNetworkId)"
						           Placeholder="Selecteer een meetnet: " Clearable="true" Variant="Variant.Outlined">
							@foreach (var network in _networks)
							{
								<MudSelectItem Value="@(network.Id as Guid?)">@network.Name</MudSelectItem>
							}
						</MudSelect>
					</MudItem>
				</MudGrid>
			</MudCardContent>
		</MudForm>
		<MudCardActions Style="display:flex; justify-content:flex-end; gap:10px; margin-right:8px">
			<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@EditProjectAsync">Opslaan
			</MudButton>
			<MudButton Href="/projects" Variant="Variant.Outlined" Color="Color.Primary">Annuleren
			</MudButton>
		</MudCardActions>
	</MudCard>
}