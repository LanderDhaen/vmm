@page "/workorders"
@using Rise.Client.Components
@using Rise.Shared.WorkOrders
@using Rise.Shared.MaintObjects
<PageTitle>Werkbonnen</PageTitle>

@* Desktop view *@

<MudHidden Breakpoint="Breakpoint.Xs">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              DebounceInterval="300"
		              OnDebounceIntervalElapsed="HandleDesktopIntervalElapsed"
		              @bind-Value="_searchTerm"
		              Margin="Margin.Dense"/>
		<MudButton Variant="Variant.Filled"
		           Size="Size.Small"
		           StartIcon="@Icons.Material.Filled.FilterAlt"
		           Color="Color.Primary"
							 OnClick="@ToggleFiltersDrawer"
		           Class="px-4">
			Filteren
		</MudButton>
		<MudButton Variant="Variant.Filled"
		           StartIcon="@Icons.Material.Filled.Add"
		           Size="Size.Small"
		           Color="Color.Primary"
		           Class="px-4"
		           Disabled="true">
			Werkbon
		</MudButton>
	</MudStack>

	<MudDataGrid T="WorkOrderDto.Index"
	             ServerData="GetWorkOrdersAsync"
	             RowsPerPage="10"
	             Striped="true"
	             Hover="true"
	             SortMode="SortMode.Single"
	             RowClick="OnRowClick"
	             @ref="_grid">
		<Columns>
			<PropertyColumn Property="x => x.Priority" Title="Prioriteit" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					<MudChip T="string" Icon="@WorkOrderUtility.DefinePriorityIcon(context.Item.Priority)" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefinePriorityColor(context.Item.Priority))">
						@WorkOrderUtility.TranslatePriority(context.Item.Priority)
					</MudChip>
				</CellTemplate>
			</PropertyColumn>

			<PropertyColumn Property="x => x.MaintObj"
			                SortBy="x => x.MaintObjType"
			                Title="Onderhoudsobject"
			                HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					@MaintObjectUtility.TranslateType(context.Item.MaintObjType) @context.Item.MaintObj
				</CellTemplate>
			</PropertyColumn>

			<PropertyColumn Property="x => x.Name" Title="Titel" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Technician" Title="Technieker" HeaderClass="mud-theme-primary"/>

			<PropertyColumn Property="x => x.Status" Title="Status" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefineStatusColor(context.Item.Status))">
						@WorkOrderUtility.TranslateStatus(context.Item.Status)
					</MudChip>
				</CellTemplate>
			</PropertyColumn>

			<PropertyColumn Property="x => x.StartDate" Title="Startdatum" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.EndDate" Title="Einddatum" HeaderClass="mud-theme-primary"/>
		</Columns>
		
		<PagerContent>
			<Pagination T="WorkOrderDto.Index" />
		</PagerContent>
		
	</MudDataGrid>
</MudHidden>

@* Mobile view *@

<MudHidden Breakpoint="Breakpoint.SmAndUp">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              Disabled="true"
		              FullWidth="true"
		              Margin="Margin.Dense"/>

		<MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha"
		               Color="Color.Primary"
		               Size="Size.Small"
		               OnClick="@ToggleSortingDrawer"/>

		<MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
		               Color="Color.Primary"
		               Size="Size.Small"
									 onclick="@ToggleFiltersDrawer"/>

		<MudIconButton Icon="@Icons.Material.Filled.Add"
		               Color="Color.Primary"
		               Size="Size.Small"
		               Disabled="true"/>
	</MudStack>

	<MudGrid Spacing="4">
		@if (_mobilityWorkOrders is null)
		{
			<MudItem xs="12">
				<div>
					<MudProgressCircular Indeterminate="true"/>
				</div>
			</MudItem>
		}
		else if (!_mobilityWorkOrders.Any())
		{
			<MudItem xs="12">
				<MudText>Geen werkbonnen</MudText>
			</MudItem>
		}
		else
		{
			@foreach (var item in _mobilityWorkOrders)
			{
				<MudItem xs="12">
					<MudCard Elevation="2"
					         Class="rounded-lg cursor-pointer"
					         @onclick="() => NavigateToDetail(item.Id)">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
									<MudText Typo="Typo.h6" Color="Color.Primary">@item.Name</MudText>
									<MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
										<MudChip T="string" Icon="@WorkOrderUtility.DefinePriorityIcon(item.Priority)" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefinePriorityColor(item.Priority))">
											@WorkOrderUtility.TranslatePriority(item.Priority)
										</MudChip>
										<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefineStatusColor(item.Status))">
											@WorkOrderUtility.TranslateStatus(item.Status)
										</MudChip>
									</MudStack>
								</MudStack>
								<MudText Typo="Typo.h6"><b>@MaintObjectUtility.TranslateType(item.MaintObjType) @item.MaintObj</b></MudText>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent Class="pt-0">
							<MudText><b>Technieker: </b> @item.Technician</MudText>
							<MudText><b>Start datum:</b> @WorkOrderUtility.ToLongStartDate(item.StartDate)</MudText>
							<MudText><b>Eind datum:</b> @WorkOrderUtility.ToLongEndDate(item.EndDate)</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>
			}
		}
	</MudGrid>
</MudHidden>
<MudDrawer Anchor="Anchor.Bottom"
           Variant="DrawerVariant.Temporary"
           Elevation="8"
           @bind-Open="_mobileSortOptionsOpen"
           Class="pa-4 rounded-lg">

	<MudText Typo="Typo.h6">Sorteren</MudText>

	<MudStack Spacing="4">
		<MudDivider/>

		@foreach (var column in SortColumns)
		{
			<MudStack Row="true" AlignItems="AlignItems.Center">
				<MudText>@column.Label</MudText>
				<MudSpacer/>

				<MudButton
					Variant="@(_activeSorting == column.Value && !_activeSortingDesc ? Variant.Filled : Variant.Outlined)"
					Color="@(_activeSorting == column.Value && !_activeSortingDesc ? Color.Primary : Color.Default)"
					Size="Size.Small"
					OnClick="@(async () => await SortMobileAsync(column.Value, false))">
					Oplopend
				</MudButton>

				<MudButton
					Variant="@(_activeSorting == column.Value && _activeSortingDesc ? Variant.Filled : Variant.Outlined)"
					Color="@(_activeSorting == column.Value && _activeSortingDesc ? Color.Primary : Color.Default)"
					Size="Size.Small"
					OnClick="@(async () => await SortMobileAsync(column.Value, true))">
					Aflopend
				</MudButton>
			</MudStack>
		}

		<MudDivider/>

		<MudButton Variant="Variant.Text"
		           Color="Color.Primary"
		           OnClick="@ToggleSortingDrawer">
			Sluiten
		</MudButton>
	</MudStack>
</MudDrawer>

@if (_filterOptionsOpen)
{
	<MudDrawer Anchor="@_filterDrawerAnchor" Variant="DrawerVariant.Temporary" Elevation="8" @bind-Open="_filterOptionsOpen" Class="@GetFilterDrawerClass()">
		<MudText Typo="Typo.h6" Color="Color.Primary">Filteren</MudText>
		<MudStack Spacing="3" Class="pa-4 mt-2">
			<MudDivider/>

			<MudSelect T="WorkOrderStatus?" Label="Status" Value="_filterStatus" ValueChanged="@(async val => { _filterStatus = val; await ApplyOrReloadOnChangeAsync(); })" Dense="true" Clearable="true" OnOpen="HandleStatusSelectOpen">
				@if (_statusOptions is null)
				{
					<MudSelectItem T="WorkOrderStatus?" Disabled="true">Laden...</MudSelectItem>
				}
				else
				{
					@foreach (var s in _statusOptions)
					{
						<MudSelectItem T="WorkOrderStatus?" Value="@((WorkOrderStatus?)s)">@WorkOrderUtility.TranslateStatus(s)</MudSelectItem>
					}
				}
			</MudSelect>

			<MudSelect T="MaintObjType?" Label="Type object" Value="_filterMaintObjType" ValueChanged="@(async val => { _filterMaintObjType = val; await ApplyOrReloadOnChangeAsync(); })" Dense="true" Clearable="true" OnOpen="HandleMaintObjTypeSelectOpen">
				@if (_maintObjTypeOptions == null)
				{
					<MudSelectItem T="MaintObjType?" Disabled="true">Laden...</MudSelectItem>
				}
				else
				{
					@foreach (var t in _maintObjTypeOptions)
					{
						<MudSelectItem T="MaintObjType?" Value="@((MaintObjType?)t)">@MaintObjectUtility.TranslateType(t)</MudSelectItem>
					}
				}
			</MudSelect>

			<MudSelect T="string" Label="Technieker" Value="_filterTechnician" ValueChanged="@(async val => { _filterTechnician = val; await ApplyOrReloadOnChangeAsync(); })" Dense="true" Clearable="true" Placeholder="Selecteer technieker..." OnOpen="HandleTechnicianSelectOpen">
				@if (_filterTechnicianOptions is null)
				{
					<MudSelectItem T="string" Disabled="true">Laden...</MudSelectItem>
				}
				else
				{
					@foreach (var t in _filterTechnicianOptions)
					{
						<MudSelectItem T="string" Value="@t">@t</MudSelectItem>
					}
				}
			</MudSelect>

			<MudDatePicker T="DateTime?" Label="Startdatum (vanaf)" Date="_filterStartDate" DateChanged="@(async val => { _filterStartDate = val; if (_filterStartDate.HasValue && _filterEndDate.HasValue && _filterEndDate.Value <= _filterStartDate.Value) { _filterEndDate = null; } await ApplyOrReloadOnChangeAsync(); })" Clearable="true" PickerVariant="PickerVariant.Dialog"/>
			<MudDatePicker T="DateTime?" Label="Einddatum (t.e.m.)" Date="_filterEndDate" DateChanged="@(async val => { _filterEndDate = val; await ApplyOrReloadOnChangeAsync(); })" Clearable="true" PickerVariant="PickerVariant.Dialog" MinDate="_filterStartDate?.AddDays(1)"/>

			<MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="pt-2">
				<MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@ClearFilters">Wissen</MudButton>
			</MudStack>
		</MudStack>
	</MudDrawer>
}