@page "/workorders"
@using Rise.Client.Components
@using Rise.Shared.WorkOrders
<PageTitle>Werkbonnen</PageTitle>

@* Desktop view *@

<MudHidden Breakpoint="Breakpoint.Xs">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              Disabled="true"
		              Margin="Margin.Dense"/>
		<MudButton Variant="Variant.Filled"
		           Size="Size.Small"
		           StartIcon="@Icons.Material.Filled.FilterAlt"
		           Color="Color.Primary"
		           Class="px-4"
		           Disabled="true">
			Filteren
		</MudButton>
		<MudButton Variant="Variant.Filled"
		           StartIcon="@Icons.Material.Filled.Add"
		           Size="Size.Small"
		           Color="Color.Primary"
		           Class="px-4"
		           Disabled="true">
			Werkbon
		</MudButton>
	</MudStack>

	<MudDataGrid T="WorkOrderDto.Index"
	             ServerData="GetWorkOrdersAsync"
	             RowsPerPage="10"
	             Striped="true"
	             Hover="true"
	             SortMode="SortMode.Single"
	             AllowUnsorted="false"
	             ShowColumnOptions="false"
	>

		<Columns>
			<PropertyColumn Property="x => x.Priority" Title="Prioriteit" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					<MudChip T="string" Icon="@WorkOrderUtility.DefinePriorityIcon(context.Item.Priority)" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefinePriorityColor(context.Item.Priority))">
						@WorkOrderUtility.TranslatePriority(context.Item.Priority)
					</MudChip>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.MaintObj" Title="Onderhoudsobject" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Name" Title="Titel" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Technician" Title="Technieker" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Status" Title="Status" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefineStatusColor(context.Item.Status))">
						@WorkOrderUtility.TranslateStatus(context.Item.Status)
					</MudChip>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.StartDate" Title="Startdatum" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.EndDate" Title="Einddatum" HeaderClass="mud-theme-primary"/>
		</Columns>
		
		<PagerContent>
			<Pagination T="WorkOrderDto.Index" />
		</PagerContent>
		
	</MudDataGrid>
</MudHidden>

@* Mobile view *@

<MudHidden Breakpoint="Breakpoint.SmAndUp">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              Disabled="true"
		              FullWidth="true"
		              Margin="Margin.Dense"/>

		<MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha"
		               Color="Color.Primary"
		               Size="Size.Small"
		               Disabled="true"/>

		<MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
		               Color="Color.Primary"
		               Size="Size.Small"
		               Disabled="true"/>

		<MudIconButton Icon="@Icons.Material.Filled.Add"
		               Color="Color.Primary"
		               Size="Size.Small"
		               Disabled="true"/>
	</MudStack>

	<MudGrid Spacing="4">
		@if (_mobilityWorkOrders is null)
		{
			<MudItem xs="12">
				<div>
					<MudProgressCircular Indeterminate="true"/>
				</div>
			</MudItem>
		}
		else if (!_mobilityWorkOrders.Any())
		{
			<MudItem xs="12">
				<MudText>Geen projecten</MudText>
			</MudItem>
		}
		else
		{
			@foreach (var item in _mobilityWorkOrders)
			{
				<MudItem xs="12">
					<MudCard Elevation="2"
					         Class="rounded-lg"
					         >
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Class="pr-3" Row="true" AlignItems="AlignItems.Center"
								          Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.subtitle1" Color="Color.Primary"><b>@item.MaintObj</b></MudText>
									<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefineStatusColor(item.Status))">
										@WorkOrderUtility.TranslateStatus(item.Status)
									</MudChip>
								</MudStack>
								<MudText Typo="Typo.h6">@item.Name</MudText>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent Class="pt-0">
						</MudCardContent>
					</MudCard>
				</MudItem>
			}
		}
	</MudGrid>
</MudHidden>