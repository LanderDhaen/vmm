@page "/workorders"
@using Rise.Client.Components
@using Rise.Client.Components.WorkOrders
@using Rise.Shared.WorkOrders
<PageTitle>Werkbonnen</PageTitle>

@* Desktop view *@

<MudHidden Breakpoint="Breakpoint.Xs">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              Disabled="true"
		              Margin="Margin.Dense"/>
		<MudButton Variant="Variant.Filled"
		           Size="Size.Small"
		           StartIcon="@Icons.Material.Filled.FilterAlt"
		           Color="Color.Primary"
		           Class="px-4"
		           Disabled="true">
			Filteren
		</MudButton>
		<MudButton Variant="Variant.Filled"
		           StartIcon="@Icons.Material.Filled.Add"
		           Size="Size.Small"
		           Color="Color.Primary"
		           Class="px-4"
		           OnClick="@NavigateToCreate">
			Werkbon
		</MudButton>
	</MudStack>

	<MudDataGrid T="WorkOrderDto.Index"
	             ServerData="GetWorkOrdersAsync"
	             RowsPerPage="10"
	             Striped="true"
	             Hover="true"
	             SortMode="SortMode.Single"
	             RowClick="OnRowClick">

		<Columns>
			<PropertyColumn Property="x => x.Priority" Title="Prioriteit" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					<WorkOrderPriorityChip Priority="@context.Item.Priority"/>
				</CellTemplate>
			</PropertyColumn>

			<PropertyColumn Property="x => x.MaintObj"
			                SortBy="x => x.MaintObjType"
			                Title="Onderhoudsobject"
			                HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					@MaintObjectUtility.TranslateType(context.Item.MaintObjType) @context.Item.MaintObj
				</CellTemplate>
			</PropertyColumn>

			<PropertyColumn Property="x => x.Name" Title="Titel" HeaderClass="mud-theme-primary"/>
			<PropertyColumn Property="x => x.Technician" Title="Technieker" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					@(context.Item.Technician ?? "-")
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.Status" Title="Status" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					<WorkOrderStatusChip Status="@context.Item.Status"/>
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.StartDate" Title="Startdatum" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					@WorkOrderUtility.ToShortStartDate(context.Item.StartDate)
				</CellTemplate>
			</PropertyColumn>
			<PropertyColumn Property="x => x.EndDate" Title="Einddatum" HeaderClass="mud-theme-primary">
				<CellTemplate Context="context">
					@WorkOrderUtility.ToShortEndDate(context.Item.EndDate)
				</CellTemplate>
			</PropertyColumn>
		</Columns>

		<PagerContent>
			<Pagination T="WorkOrderDto.Index"/>
		</PagerContent>

	</MudDataGrid>
</MudHidden>

@* Mobile view *@

<MudHidden Breakpoint="Breakpoint.SmAndUp">
	<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pb-6">
		<MudTextField T="string"
		              Label="Zoek"
		              Class="my-0"
		              Variant="Variant.Outlined"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.Search"
		              Disabled="true"
		              FullWidth="true"
		              Margin="Margin.Dense"/>

		<MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha"
		               Color="Color.Primary"
		               Size="Size.Small"
		               OnClick="@ToggleSortingDrawer"/>

		<MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
		               Color="Color.Primary"
		               Size="Size.Small"
		               Disabled="true"/>

		<MudIconButton Icon="@Icons.Material.Filled.Add"
		               Color="Color.Primary"
		               Size="Size.Small"
		               OnClick="@NavigateToCreate"/>
	</MudStack>

	<MudGrid Spacing="4">
		@if (_mobilityWorkOrders is null)
		{
			<MudItem xs="12">
				<div>
					<MudProgressCircular Indeterminate="true"/>
				</div>
			</MudItem>
		}
		else if (!_mobilityWorkOrders.Any())
		{
			<MudItem xs="12">
				<MudText>Geen werkbonnen</MudText>
			</MudItem>
		}
		else
		{
			@foreach (var item in _mobilityWorkOrders)
			{
				<MudItem xs="12">
					<MudCard Elevation="2"
					         Class="rounded-lg cursor-pointer"
					         @onclick="() => NavigateToDetail(item.Id)">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
									<MudText Typo="Typo.h6" Color="Color.Primary">@item.Name</MudText>
									<MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
										<WorkOrderPriorityChip Priority="@item.Priority"/>
										<WorkOrderStatusChip Status="@item.Status"/>
									</MudStack>
								</MudStack>
								<MudText Typo="Typo.h6">
									<b>@MaintObjectUtility.TranslateType(item.MaintObjType) @item.MaintObj</b></MudText>
							</CardHeaderContent>
						</MudCardHeader>
						<MudCardContent Class="pt-0">
							<MudText><b>Technieker:</b> @(item.Technician ?? "-")</MudText>
							<MudText><b>Startdatum:</b> @WorkOrderUtility.ToShortStartDate(item.StartDate)</MudText>
							<MudText><b>Einddatum:</b> @WorkOrderUtility.ToShortEndDate(item.EndDate)</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>
			}
		}
	</MudGrid>
</MudHidden>

@* Sort drawer (mobile) *@
@if (_mobileSortOptionsOpen)
{
	<MudDrawer Anchor="Anchor.Bottom"
	           Variant="DrawerVariant.Temporary"
	           Elevation="8"
	           @bind-Open="_mobileSortOptionsOpen"
	           Class="py-6 px-4 rounded-lg">

		<MudText Class="pb-4" Typo="Typo.h6">Sorteren</MudText>

		<MudStack Spacing="1">
			<MudDivider/>

			@foreach (var column in SortColumns)
			{
				<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
					<MudText>@column.Label</MudText>
					<MudIconButton
						Icon="@(_activeSorting == column.Value && _activeSortingDesc ? Icons.Material.Outlined.ArrowDownward : Icons.Material.Outlined.ArrowUpward)"
						Color="@(_activeSorting == column.Value ? Color.Primary : Color.Default)"
						Size="Size.Medium"
						OnClick="@(() => SortMobileAsync(column.Value, _activeSorting == column.Value && !_activeSortingDesc))">
					</MudIconButton>
				</MudStack>
			}
		</MudStack>
	</MudDrawer>
}
