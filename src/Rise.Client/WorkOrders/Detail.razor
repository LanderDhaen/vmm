@page "/workorders/{WorkOrderId:guid}"
@using Rise.Client.Components.Locations
@using Rise.Client.Components.MaintObjects
@using Rise.Client.Components.WorkOrders
@using Rise.Shared.WorkOrders

<PageTitle>Werkbon Details</PageTitle>

@if (_workOrder is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	@* Tabs *@
	<MudStack Class="pt-2" Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Spacing="6">
		<MudStack Row="true" Spacing="8">
			<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
			         @onclick="() => SetTab(0)">
				@_tabs[0]
			</MudText>
			<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
			         @onclick="() => SetTab(1)">
				@_tabs[1]
			</MudText>
		</MudStack>
	</MudStack>

	@switch (_selectedTab)
	{
		case 0:
			@* Toolbar *@
			<MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mt-2">
					@switch (_workOrder.Status)
					{
						case WorkOrderStatus.Pending: 
							<MudButton StartIcon="@Icons.Material.Filled.RocketLaunch"
							           Class="border-b-2"
							           Size="Size.Small"
							           Variant="Variant.Filled"
							           Color="Color.Info"
							           OnClick="@ShowStartConfirmationAsync">
								Opnemen
							</MudButton>
							break;
							
						case WorkOrderStatus.Completed:
							<MudButton StartIcon="@Icons.Material.Filled.RestartAlt"
							           Size="Size.Small"
							           Variant="Variant.Filled"
							           Color="Color.Warning"
							           OnClick="@ShowStartConfirmationAsync">
								Heropenen
							</MudButton>
							break;

						case WorkOrderStatus.InProgress:
							<MudButton StartIcon="@Icons.Material.Filled.Check"
							           Size="Size.Small"
							           Variant="Variant.Filled"
							           Color="Color.Success"
							           OnClick="@ShowCloseConfirmationAsync">
								Voltooien
							</MudButton>
							break;
						default:
							break;
					}
			</MudStack>

			<MudGrid Spacing="4" Class="mt-2">
				@* Details *@
				<MudItem xs="12" md="6">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudText Typo="Typo.h6" Color="Color.Primary">@_workOrder.Name</MudText>
								<MudText Typo="Typo.subtitle2">@_workOrder.Description</MudText>
							</CardHeaderContent>
						</MudCardHeader>

						<MudCardContent>
							<MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">
								<MudText><b>Prioriteit:</b></MudText>
								<WorkOrderPriorityChip Priority="_workOrder.Priority"/>
							</MudStack>
							<MudText><b>Technieker:</b> @(_workOrder.Technician ?? "-")</MudText>
							<MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">
								<MudText><b>Status:</b></MudText>
								<WorkOrderStatusChip Status="_workOrder.Status"/>
							</MudStack>
							<MudText><b>Startdatum:</b> @WorkOrderUtility.ToLongStartDate(_workOrder.StartDate)
							</MudText>
							<MudText><b>Einddatum:</b> @WorkOrderUtility.ToLongEndDate(_workOrder.EndDate)</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				<MudItem xs="12" md="6">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6" Color="Color.Primary">Onderhoudsobject</MudText>
									<MudButton Variant="Variant.Text"
									           StartIcon="@Icons.Material.Filled.OpenInNew"
									           Size="Size.Small"
									           Color="Color.Primary"
									           Class="px-4"
									           OnClick="@(() => NavigateToMaintObj(_workOrder.MaintObj.Id))">
										Bekijk
									</MudButton>
								</MudStack>

								@if (_workOrder.MaintObj.StationCode is null)
								{
									<MudText Typo="Typo.subtitle2">
										Momenteel in stock
									</MudText>
								}
								else
								{
									<MudText Typo="Typo.subtitle2">
										Geplaatst in meetstation @_workOrder.MaintObj.StationCode
									</MudText>
								}

							</CardHeaderContent>
						</MudCardHeader>

						<MudCardContent>
							<MudStack Row="true" Justify="Justify.FlexStart" Spacing="2">
								<MudText><b>Status:</b></MudText>
								<MaintObjStatusChip Status="_workOrder.MaintObj.MaintObjStatus"/>
							</MudStack>
							<MudText><b>Type:</b> @MaintObjectUtility.TranslateType(_workOrder.MaintObj.MaintObjType)
							</MudText>
							<MudText><b>Code:</b> @_workOrder.MaintObj.SerialNumber</MudText>
							<MudText><b>Naam:</b> @_workOrder.MaintObj.Name</MudText>
							<MudText><b>Merk:</b> @(_workOrder.MaintObj.Brand ?? "-")</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				<MudItem xs="12" md="6">
					<LocationCard Location="_workOrder.Location" ShowMoveButton="false"/>
				</MudItem>

			</MudGrid>
			break;

		case 1:
			<div>Historiek?</div>
			break;
	}
}
