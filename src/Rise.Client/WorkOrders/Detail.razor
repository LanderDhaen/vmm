@page "/workorders/{WorkOrderId:guid}"
@using Rise.Client.Components.Locations
@using Rise.Shared.WorkOrders

<PageTitle>Werkbon Details</PageTitle>

@if (_workOrder is null)
{
	<MudContainer Class="d-flex justify-center align-center" Style="height:100vh;">
		<MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary"/>
	</MudContainer>
}
else
{
	<MudStack Row="true" Justify="Justify.SpaceBetween">
		<MudStack Row="true" Spacing="8">
			<MudText Class="@($"tab-item {(_selectedTab == 0 ? "active" : "")}")"
			         @onclick="() => SetTab(0)">
				@_tabs[0]
			</MudText>
			<MudText Class="@($"tab-item {(_selectedTab == 1 ? "active" : "")}")"
			         @onclick="() => SetTab(1)">
				@_tabs[1]
			</MudText>
		</MudStack>

		<MudHidden Breakpoint="Breakpoint.SmAndDown">
			@switch (_workOrder.Status)
			{
				case WorkOrderStatus.Pending:
					<MudStack Row="true" Spacing="2">
						<MudButton Variant="Variant.Outlined"
						           Color="Color.Primary"
						           OnClick="@ShowStartConfirmationAsync">
							Starten
						</MudButton>

						<MudButton Variant="Variant.Outlined"
						           Color="Color.Error"
						           OnClick="@ShowCancelConfirmationAsync">
							Annuleren
						</MudButton>
					</MudStack>
					break;

				case WorkOrderStatus.InProgress:
					<MudButton Variant="Variant.Outlined"
					           Color="Color.Error"
					           OnClick="@ShowCloseConfirmationAsync">
						Afsluiten
					</MudButton>
					break;

				case WorkOrderStatus.Completed:
					<MudButton Variant="Variant.Outlined"
					           Color="Color.Success"
					           OnClick="@ShowStartConfirmationAsync">
						Heropenen
					</MudButton>
					break;

				case WorkOrderStatus.Cancelled:
					break;
			}
		</MudHidden>
	</MudStack>

	@switch (_selectedTab)
	{
		case 0:
			<MudGrid Spacing="4" Class="mt-4">
				<MudItem xs="12" md="6">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6" Color="Color.Primary">@_workOrder.Name</MudText>
									<MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
										<MudChip T="string"
										         Icon="@WorkOrderUtility.DefinePriorityIcon(_workOrder.Priority)"
										         Size="Size.Small"
										         Variant="Variant.Outlined"
										         Color="@WorkOrderUtility.DefinePriorityColor(_workOrder.Priority)">
											@WorkOrderUtility.TranslatePriority(_workOrder.Priority)
										</MudChip>
										<MudChip T="string"
										         Size="Size.Small"
										         Variant="Variant.Outlined"
										         Color="@WorkOrderUtility.DefineStatusColor(_workOrder.Status)">
											@WorkOrderUtility.TranslateStatus(_workOrder.Status)
										</MudChip>
									</MudStack>
								</MudStack>

								<MudText Typo="Typo.subtitle2">@_workOrder.Description</MudText>
							</CardHeaderContent>
						</MudCardHeader>

						<MudCardContent>
							<MudText><b>Technieker:</b> @(_workOrder.Technician ?? "-")</MudText>
							<MudText><b>Startdatum:</b> @WorkOrderUtility.ToLongStartDate(_workOrder.StartDate)</MudText>
							<MudText><b>Einddatum:</b> @WorkOrderUtility.ToLongEndDate(_workOrder.EndDate)</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				<MudItem xs="12" md="6">
					<MudCard Elevation="2" Class="rounded-lg">
						<MudCardHeader>
							<CardHeaderContent>
								<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
									<MudText Typo="Typo.h6" Color="Color.Primary">Onderhoudsobject</MudText>
									<MudStack Row="true" Justify="Justify.SpaceBetween">
										<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
										         Color="@(MaintObjectUtility.DefineStatusColor(_workOrder.MaintObj.MaintObjStatus))">
											@MaintObjectUtility.TranslateStatus(_workOrder.MaintObj.MaintObjStatus)
										</MudChip>
										<MudButton Variant="Variant.Text"
										           StartIcon="@Icons.Material.Filled.OpenInNew"
										           Size="Size.Small"
										           Color="Color.Primary"
										           Class="px-4"
										           OnClick="@(() => NavigateToMaintObj(_workOrder.MaintObj.Id))">
											Bekijk
										</MudButton>
									</MudStack>
								</MudStack>

								<MudText Typo="Typo.subtitle2">
									@MaintObjectUtility.TranslateType(_workOrder.MaintObj.MaintObjType)
									in @(_workOrder.MaintObj.StationCode ?? "-")
								</MudText>
							</CardHeaderContent>
						</MudCardHeader>

						<MudCardContent>
							<MudText><b>Code:</b> @_workOrder.MaintObj.SerialNumber</MudText>
							<MudText><b>Naam:</b> @_workOrder.MaintObj.Name</MudText>
							<MudText><b>Merk:</b> @(_workOrder.MaintObj.Brand ?? "-")</MudText>
						</MudCardContent>
					</MudCard>
				</MudItem>

				<MudItem xs="12" md="6">
					<LocationCard Location="_workOrder.Location" ShowMoveButton="false"/>
				</MudItem>

			</MudGrid>
			break;

		case 1:
			<div>Historiek?</div>
			break;
	}
	
	<MudHidden Breakpoint="Breakpoint.MdAndUp">
		<MudStack Row="true"
		          Spacing="2"
		          Style="position:fixed; right:16px; bottom:16px; z-index:10;">

			@switch (_workOrder.Status)
			{
				case WorkOrderStatus.Pending:
					<MudButton Variant="Variant.Outlined"
					           Color="Color.Primary"
					           OnClick="@ShowStartConfirmationAsync">
						Starten
					</MudButton>

					<MudButton Variant="Variant.Outlined"
					           Color="Color.Error"
					           OnClick="@ShowCancelConfirmationAsync">
						Annuleren
					</MudButton>
					break;

				case WorkOrderStatus.InProgress:
					<MudButton Variant="Variant.Outlined"
					           Color="Color.Error"
					           OnClick="@ShowCloseConfirmationAsync">
						Afsluiten
					</MudButton>
					break;

				case WorkOrderStatus.Completed:
					<MudButton Variant="Variant.Outlined"
					           Color="Color.Success"
					           OnClick="@ShowStartConfirmationAsync">
						Heropenen
					</MudButton>
					break;

				case WorkOrderStatus.Cancelled:
					break;
			}
		</MudStack>
	</MudHidden>
}
