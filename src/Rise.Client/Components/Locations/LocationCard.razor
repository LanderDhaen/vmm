<MudCard Elevation="2" Class="rounded-lg">
	<MudCardHeader>
		<CardHeaderContent>
			<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
				<MudText Typo="Typo.h6" Color="Color.Primary">Locatie</MudText>
				@if (ShowMoveButton)
				{
					<MudTooltip Text="Van locatie verplaatsen" Delay="600">
						<MudButton Variant="Variant.Text"
						           StartIcon="@Icons.Material.Filled.MyLocation"
						           Size="Size.Small"
						           Color="Color.Primary"
						           Class="px-4"
						           OnClick="@OnClick">
							Verplaatsen
						</MudButton>
					</MudTooltip>
				}
			</MudStack>
			<MudText Typo="Typo.subtitle2">@Location.Name</MudText>
		</CardHeaderContent>
	</MudCardHeader>

	<MudCardContent>
		<MudText>
			<b>Adres:</b>
			@LocationUtility.FormatAddress(
				Location.AddressLine1,
				Location.AddressLine2,
				Location.City,
				Location.PostalCode,
				Location.Country)
		</MudText>

		<MudText><b>Breedtegraad:</b> @Location.X</MudText>
		<MudText><b>Lengtegraad:</b> @Location.Y</MudText>
	</MudCardContent>
</MudCard>