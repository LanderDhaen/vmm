<MudItem xs="12">
	<MudCard Elevation="2"
	         Class="rounded-lg"
	         @onclick="() => NavigateToMaintObj(MaintObj.Id)">
		<MudCardHeader>
			<CardHeaderContent>
				<MudStack Class="pr-3" Row="true" AlignItems="AlignItems.Center"
				          Justify="Justify.SpaceBetween">
					<MudText Typo="Typo.h6" Color="Color.Primary">@MaintObj.SerialNumber</MudText>
					<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
					         Color="@(MaintObjectUtility.DefineStatusColor(MaintObj.MaintObjStatus))">
						@MaintObjectUtility.TranslateStatus(MaintObj.MaintObjStatus)
					</MudChip>
				</MudStack>
				<MudText Typo="Typo.h6">@MaintObj.Name @MaintObjectUtility.TranslateType(MaintObj.MaintObjType)</MudText>
			</CardHeaderContent>
		</MudCardHeader>
		<MudCardContent Class="pt-0">
			<MudText><b>Merk:</b> @MaintObj.Brand</MudText>
			<MudText><b>Locatie:</b> @MaintObj.Location</MudText>
		</MudCardContent>
	</MudCard>
</MudItem>