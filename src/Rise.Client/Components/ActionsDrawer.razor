@namespace Rise.Client.Layout
@using Microsoft.AspNetCore.Components
@using MudBlazor

<!--
  ActionsDrawer.razor
  - Responsive Drawer (Anchor changes with breakpoint).
  - Binds MudDrawer.Open to the internal property `_open` (which intercepts changes).
  - The MudDrawer component in this version does not provide an OnClose event, therefore
    we detect closes by observing the bound `_open` property's setter.
-->
<MudBreakpointProvider OnBreakpointChanged="@(bp => {
    CurrentAnchor = bp <= Breakpoint.Md ? Anchor.Bottom : Anchor.Right;
    StateHasChanged();
})">
    <MudDrawer @bind-Open="_open"
               Anchor="@CurrentAnchor"
               Variant="DrawerVariant.Temporary"
               Elevation="8"
               OverlayAutoClose="true">
        <MudButton StartIcon="@Icons.Material.Filled.AddBox"
                   Color="Color.Primary"
                   Size="Size.Large"
                   OnClick="@NavigateToCreate">
            @ButtonText
        </MudButton>
    </MudDrawer>
</MudBreakpointProvider>

