@* File: DrawerMenu.razor *@
<MudNavMenu Elevation="0">
	<MudDrawerHeader Class="pa-0">
		<MudImage Src="/img/logo.png" Alt="Logo" Fluid="true" />
	</MudDrawerHeader>

	@foreach (var item in _items)
	{
		<MudHidden Breakpoint="Breakpoint.SmAndDown">
			<MudNavLink Match="NavLinkMatch.Prefix"
			            Class="mt-4 mb-4"
			            Icon="@item.Icon"
			            Href="@item.Href">
				@item.Title
			</MudNavLink>
		</MudHidden>
		<MudHidden Breakpoint="Breakpoint.MdAndUp">
			<MudNavLink Match="NavLinkMatch.Prefix"
			            Class="mt-4 mb-4"
			            Icon="@item.Icon"
			            Href="@item.Href">
				@item.Title
			</MudNavLink>
		</MudHidden>
	}
</MudNavMenu>