@* src/Rise.Client/Components/DrawerMenu.razor *@
<MudNavMenu>
	<MudDrawerHeader Class="p-0">
		<img src="/img/logo.png" alt="VMM logo" style="width:auto"/>
	</MudDrawerHeader>

	@foreach (var item in _items)
	{
		<MudNavLink Href="@GetHref(item.Slug)" Match="NavLinkMatch.All">
			<MudIconButton Icon="@item.Icon"/>
			@item.Title
		</MudNavLink>
	}
</MudNavMenu>