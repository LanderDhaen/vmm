@using MudBlazor

<div class="d-flex align-center">
	<MudIconButton
		Class="p-0"
		Icon="@Icons.Material.Outlined.ArrowBack"
		OnClick="@OnBack"
		Style="background: transparent;"/>
	<MudText Class="" Typo="Typo.h3" Style="font-weight: 800">@Title</MudText>

	@* TODO: menu will always be shown -> declare this higher up *@
	<div class="ml-auto">
		<MudIcon Icon="@Icons.Material.Outlined.Menu" Style="font-size: 3rem"/>
	</div>
</div>