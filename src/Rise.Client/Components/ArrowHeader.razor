@using MudBlazor

<div class="d-flex align-center">
	<MudIcon
		Class="p-0"
		Icon="@Icons.Material.Outlined.ArrowBack"
		OnClick="@OnBack"
		Style="background: transparent;color: #126B8D; font-size: 2rem;"/>
	<MudText Class="ml-1" Typo="Typo.h3" Style="font-weight: 800">@Title</MudText>

	@* TODO: menu will always be shown -> declare this higher up *@
	<div class="ml-auto">
		<MudIcon Icon="@Icons.Material.Outlined.Menu" Style="font-size: 3rem; color: #126B8D"/>
	</div>
</div>