<div class="d-flex align-center">
	<MudIconButton
		Size="Size.Large"
		Class="p-0"
		Icon="@Icons.Material.Outlined.ArrowBack"
		OnClick="@OnBack"
		Color="Color.Primary"/>
	<MudText Class="ml-1" Typo="Typo.h3" Style="font-weight: 800">@Title</MudText>

	@* TODO: menu will always be shown -> declare this higher up *@
	<div class="ml-auto">
		<MudIcon Icon="@Icons.Material.Outlined.Menu" Color="Color.Primary" Style="font-size: 3rem;"/>
	</div>
</div>