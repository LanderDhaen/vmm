@* Desktop view *@

<MudHidden Breakpoint="Breakpoint.Xs">
	<MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
		<ItemOpposite>
			<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@HistoryUtility.ToShortValidFrom(ModifiedAt)</MudChip>
		</ItemOpposite>
		<ItemContent>
			<MudText Typo="Typo.h6">@Title</MudText>
			<MudText>
				van <b>@PreviousValue</b> naar <b>@CurrentValue</b>
			</MudText>
		</ItemContent>
	</MudTimelineItem>
</MudHidden>

@* Mobile view *@

<MudHidden Breakpoint="Breakpoint.SmAndUp">
	<MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
		<ItemContent>
			<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@ModifiedAt</MudChip>
			<MudText Typo="Typo.h6">@Title</MudText>
			<MudText>
				van <b>@PreviousValue</b> naar <b>@CurrentValue</b>
			</MudText>
		</ItemContent>
	</MudTimelineItem>
</MudHidden>