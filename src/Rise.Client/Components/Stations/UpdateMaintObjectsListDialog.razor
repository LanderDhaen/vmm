@using Rise.Client.Components.MaintObjects
@using Rise.Shared.MaintObjects
<MudDialog Class="mx-3" Style="width: 80vw; max-width: 80vh">
	<TitleContent>
		<MudText Typo="Typo.h5">Onderhoudsobjecten toevoegen</MudText>
	</TitleContent>

	<DialogContent>
		<MudTextField T="string"
		              InputType="InputType.Search"
		              Label="Zoek onderhoudsobject"
		              Class="m-0 pb-2"
		              Variant="Variant.Outlined"
		              DebounceInterval="300"
		              OnDebounceIntervalElapsed="@UpdateSearch"
		              @bind-Value="@_searchTerm"
		              Margin="Margin.Dense"
		              Adornment="Adornment.End"
		              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
		              OnAdornmentClick="OpenQrScanner"/>

		<MudTable T="MaintObjDto.Index" Items="@_allMaintObjects" Hover="true" CustomHeader="true"
		          FixedHeader="true" Dense="true">
			<HeaderContent>
				<MudTHeadRow>
					<MudTh Class="mud-theme-primary"></MudTh>
					<MudTh Class="mud-theme-primary">Naam</MudTh>
					<MudTh Class="mud-theme-primary">Serienummer</MudTh>
					<MudTh Class="mud-theme-primary">Type</MudTh>
					<MudTh Class="mud-theme-primary">Status</MudTh>
				</MudTHeadRow>
			</HeaderContent>
			<RowTemplate>
				<MudCheckBox Value="@Model.MaintObjIds.Contains(context.Id)"
				             ValueChanged="@((bool value) => OnCheckboxChanged(context.Id, value))"/>
				<MudTd DataLabel="Naam">@context.Name</MudTd>
				<MudTd DataLabel="Serienummer">@context.SerialNumber</MudTd>
				<MudTd DataLabel="Type">@context.MaintObjType</MudTd>
				<MudTd DataLabel="Status">
					<MaintObjStatusChip Status="@context.MaintObjStatus"/>
				</MudTd>
			</RowTemplate>
		</MudTable>
	</DialogContent>
	<DialogActions>
		<MudButton Variant="Variant.Filled"
		           StartIcon="@Icons.Material.Filled.Save"
		           Size="Size.Small"
		           Color="Color.Primary"
		           OnClick="@UpdateMaintObjects">
			Opslaan
		</MudButton>
		<MudButton OnClick="@Cancel" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
		           Class="my-3 mr-4">
			Annuleren
		</MudButton>
	</DialogActions>
</MudDialog>