@using Rise.Client.Components.Locations
<MudDialog Class="mx-3">
	<TitleContent>
		<MudText Typo="Typo.h6">Locatie wijzigen</MudText>
	</TitleContent>
	<DialogContent>
		<MudForm Model="@Model" @ref="form" Validation="_validator.ValidateValue" ValidationDelay="0" Style="width: 80vw; max-width: 80vh">
			<LocationForm Model="Model"></LocationForm>
		</MudForm>
	</DialogContent>

	<DialogActions>
		<MudButton Variant="Variant.Filled"
		           StartIcon="@Icons.Material.Filled.Save"
		           Size="Size.Small"
		           Color="Color.Primary"
		           OnClick="@UpdateLocationAsync">
			Opslaan
		</MudButton>
		<MudButton OnClick="@Cancel" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
		           Class="my-3 mr-4">
			Annuleren
		</MudButton>
	</DialogActions>
</MudDialog>