<MudCard Elevation="2" Class="rounded-lg">
	<MudCardHeader>
		<CardHeaderContent>
			<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
				<MudText Typo="Typo.h6" Color="Color.Primary">Meetstation</MudText>
			</MudStack>
			@* Render code only when MeasurementStation is not null to avoid NRE *@
			@if (MeasurementStation is null)
			{
				<MudText Typo="Typo.subtitle2"><em>Niet gekoppeld</em></MudText>
			}
			else
			{
				<MudText Typo="Typo.subtitle2">@MeasurementStation.Code</MudText>
				@* TODO: go to station *@
			}
		</CardHeaderContent>
	</MudCardHeader>

	<MudCardContent>
		@* <MudText> *@
		@* 	<b>Adres:</b> *@
		@* 	@LocationUtility.FormatAddress( *@
		@* 		MeasurementStation.AddressLine1, *@
		@* 		MeasurementStation.AddressLine2, *@
		@* 		MeasurementStation.City, *@
		@* 		MeasurementStation.PostalCode, *@
		@* 		MeasurementStation.Country) *@
		@* </MudText> *@

		@* <MudText><b>Breedtegraad:</b> @MeasurementStation.X</MudText> *@
		@* <MudText><b>Lengtegraad:</b> @MeasurementStation.Y</MudText> *@
	</MudCardContent>
</MudCard>