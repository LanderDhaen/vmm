@if (Station is null)
{
	<MudCard Elevation="2" Class="rounded-lg">
		<MudCardHeader>
			<CardHeaderContent>
				<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
					<MudText Typo="Typo.h6" Color="Color.Primary">Meetstation</MudText>
					@* No button when there's no station *@
				</MudStack>
				<MudText Typo="Typo.subtitle2"><em>Niet gekoppeld</em></MudText>
			</CardHeaderContent>
		</MudCardHeader>
	</MudCard>
}
else
{
	<MudCard Elevation="2" Class="rounded-lg">
		<MudCardHeader>
			<CardHeaderContent>
				<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
					<MudText Typo="Typo.h6" Color="Color.Primary">Meetstation</MudText>
					<MudButton Variant="Variant.Text"
					           StartIcon="@Icons.Material.Filled.OpenInNew"
					           Size="Size.Small"
					           Color="Color.Primary"
					           Class="px-4"
					           OnClick="@(() => NavigateToMaintObj(Station.Id))">
						Bekijk
					</MudButton>
				</MudStack>
				<MudText Typo="Typo.subtitle2">@Station.Code</MudText>
			</CardHeaderContent>
		</MudCardHeader>

		<MudCardContent>
			<MudText>
				<b>Geïnstalleerd:</b>
				@StationUtility.ToLongInstalledAt(Station.InstalledAt)

			</MudText>
			<MudText>
				<b>Verwijderd:</b>
				@StationUtility.ToLongRemovedAt(Station.RemovedAt)
			</MudText>
		</MudCardContent>
	</MudCard>
}
