<MudCard Elevation="2" Class="rounded-lg">
	<MudCardHeader>
		<CardHeaderContent>
			<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
				<MudText Typo="Typo.h6" Color="Color.Primary">Meetstation</MudText>
			</MudStack>
			<MudText Typo="Typo.subtitle2">@Station.Code</MudText>
			<MudButton Variant="Variant.Text"
			           StartIcon="@Icons.Material.Filled.OpenInNew"
			           Size="Size.Small"
			           Color="Color.Primary"
			           Class="px-4"
			           OnClick="@(() => NavigateToMaintObj(Station.Id))">
				Bekijk
			</MudButton>
		</CardHeaderContent>
	</MudCardHeader>
</MudCard>