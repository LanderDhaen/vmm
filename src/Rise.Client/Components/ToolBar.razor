@namespace Rise.Client.Layout
@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudPaper Elevation="0" Square="true" Class="toolbar-paper" Style="padding:0.25rem 0.5rem;">
  <MudHidden Breakpoint="Breakpoint.SmAndDown">
    <div style="display:flex; align-items:center; width:100%;">
      <div style="flex:0 1 44%; min-width:44%; max-width:70%; display:flex; align-items:center;">
        <MudTextField T="string" Label="Zoek" Variant="Variant.Filled"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Inherit" Color="Color.Primary"
                      Style="width:100%; background-color:white;" />
      </div>

      <div style="display:flex; align-items:center; margin-left:auto; gap:0.5rem;">
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ViewColumn" Color="Color.Primary" Style="white-space:nowrap;">Kolommen</MudButton>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" Style="white-space:nowrap;">Filteren</MudButton>
        <MudDivider Vertical="true" FlexItem="true" Color="Color.Primary" Style="height:36px; margin:0 0.25rem;" />

        @* call the parent callback with the requested anchor *@
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.MoreHoriz"
                   Color="Color.Primary"
                   Style="white-space:nowrap;"
                   OnClick="@OpenActionsDrawer">
          Acties
        </MudButton>
      </div>
    </div>
  </MudHidden>

  <MudHidden Breakpoint="Breakpoint.MdAndUp">
    <div style="display:flex; align-items:center; width:100%;">
      <div style="flex:0 1 33%; min-width:33%; max-width:80%; display:flex; align-items:center;">
        <MudTextField T="string" Label="Zoek" Variant="Variant.Filled"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Inherit" Color="Color.Primary"
                      Style="width:100%; background-color:white;" />
      </div>

      <div style="display:flex; align-items:center; margin-left:auto; gap:0.5rem;">
        <MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha" Color="Color.Primary" />
        <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" />
        <MudDivider Vertical="true" FlexItem="true" Color="Color.Primary" Style="height:36px; margin:0 0.25rem;" />

        <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz"
                       Color="Color.Primary"
                       OnClick="@OpenActionsDrawer"/>
      </div>
    </div>
  </MudHidden>
</MudPaper>

<ActionsDrawer Open="@_actionsDrawerOpen"
            OnClose="CloseActionsDrawer"/>