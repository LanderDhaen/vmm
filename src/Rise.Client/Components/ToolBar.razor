@namespace Rise.Client.Layout

<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudToolBar Gutters="false" Class="py-2 gap-3" Style="background-color: transparent;">
        <MudTextField T="string" Label="Zoek" Variant="Variant.Outlined" Size="Size.Small"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="flex-grow-1" Style="max-width: 500px;" Margin="Margin.Dense"/>
        <MudSpacer/>
        <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.ViewColumn" Color="Color.Primary" Class="px-4">Kolommen</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" Class="px-4">Filteren</MudButton>
        <MudDivider Vertical="true" FlexItem="true" Class="my-2"/>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" Color="Color.Primary" OnClick="@OpenActionsDrawer" Class="px-4">Acties</MudButton>
    </MudToolBar>
</MudHidden>

<MudHidden Breakpoint="Breakpoint.MdAndUp">
    <MudToolBar Gutters="false" Class="gap-2 mb-6" Style="background-color: transparent;">
        <MudTextField T="string" Label="Zoek" Variant="Variant.Outlined" Size="Size.Small"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="flex-grow-1" Margin="Margin.Dense"/>
        @* Mobile: request parent to open mobile sort drawer when this icon is clicked *@
        <MudIconButton Icon="@Icons.Material.Outlined.SortByAlpha" Color="Color.Primary" Size="Size.Small" OnClick="@RequestOpenSortDrawer"/>
        <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Primary" Size="Size.Small"/>
        <MudDivider Vertical="true" FlexItem="true" Class="my-4"/>
        <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Primary" Size="Size.Small" OnClick="@OpenActionsDrawer"/>
    </MudToolBar>
</MudHidden>

@* Actions drawer (bound to _actionsDrawerOpen) *@
<Rise.Client.Layout.ActionsDrawer @bind-Open="_actionsDrawerOpen" />