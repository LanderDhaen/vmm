@namespace Rise.Client.Layout
@inherits LayoutComponentBase
@using MudBlazor
@using Microsoft.AspNetCore.Components

@* Drawer wrapper: toggles .is-open class when _open is true so CSS can disable pointer-events on underlying content *@
<div class="drawer-root @(_open ? "is-open" : "")" style="position:relative;">
  <MudHidden Breakpoint="Breakpoint.SmAndDown">
    @* Desktop: show permanent/persistent drawer when ShowDrawer is true *@
    <MudCollapse Expanded="@(ShowDrawer)">
      <MudDrawer Open="@(ShowDrawer)"        
                 Variant="DrawerVariant.Persistent"  
                 Elevation="0"
                 Class="main-drawer"
                 Style="background: transparent; box-shadow: none; border-right: none;">
        <Rise.Client.Components.DrawerMenu/>
      </MudDrawer>
    </MudCollapse>
  </MudHidden>

  <!-- MOBILE: menu button top-right and temporary drawer -->
  <MudHidden Breakpoint="Breakpoint.MdAndUp">
    <!-- Menu button (fixed, top-right) -->
    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                   Size="Size.Large"
                   Style="position:fixed; top:12px; right:12px; z-index:2000; color: var(--app-accent, #126B8D);background: none;"
                   Edge="Edge.End"
                   OnClick="@ToggleDrawerAsync"
                   AriaLabel="Menu" />

    <!-- Collapse + Temporary Drawer: closes on outside click and updates state via OnClose -->
    <MudCollapse Expanded="@(_open && ShowDrawer)">
      <MudDrawer Open="@(_open && ShowDrawer)"
                 Anchor="Anchor.Right"
                 Variant="DrawerVariant.Temporary"
                 Width="70vw"
                 Elevation="8"
                 CloseOnOutsideClick="true"
                 OnClose="@OnDrawerClosed"
                 Style="height:100vh; max-width:420px;">
        <Rise.Client.Components.DrawerMenu/>
      </MudDrawer>
    </MudCollapse>
  </MudHidden>

  <!-- MAIN CONTENT -->
  <MudMainContent>
    <MudContainer>
      @ChildContent
    </MudContainer>
  </MudMainContent>
</div>