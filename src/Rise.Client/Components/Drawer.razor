@namespace Rise.Client.Layout
@inherits LayoutComponentBase
@using MudBlazor
@using Microsoft.AspNetCore.Components

@* Drawer wrapper: toggles .is-open class when _open is true so CSS can disable pointer-events on underlying content *@
<div class="drawer-root @(_open ? "is-open" : "")">
  <!-- MOBILE: temporary drawer that overlays content -->
  <MudHidden Breakpoint="Breakpoint.MdAndUp">
    @* Also on mobile we use MudCollapse so MudBlazor handles the show/hide animation.
       Additionally, the MudDrawer.Open property is tied to ShowDrawer so the drawer is not visible on the homepage. *@
    <MudCollapse Expanded="@(!_isLarge && _open && ShowDrawer)">
      <MudDrawer Open="@(_open && ShowDrawer)"
                 Anchor="Anchor.Right"
                 Variant="DrawerVariant.Temporary"
                 Width="70vw"
                 Elevation="8"
                 Class="main-drawer-mobile sort-drawer"
                 CloseOnOutsideClick="true"
                 Style="height:100vh; max-width:420px;">
        <Rise.Client.Components.DrawerMenu/>
      </MudDrawer>
    </MudCollapse>
  </MudHidden>

  <!-- MAIN CONTENT -->
  <MudMainContent>
    <MudContainer>
        @ChildContent
    </MudContainer>
  </MudMainContent>
</div>