<MudCard Elevation="2"
         Class="rounded-lg"
         @onclick="() => NavigateToWorkOrder(WorkOrder.Id)"
>
	<MudCardHeader>
		<CardHeaderContent>
			<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
				<MudText Typo="Typo.h6" Color="Color.Primary">@WorkOrder.Name</MudText>
				<MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
					<MudChip T="string" Icon="@WorkOrderUtility.DefinePriorityIcon(WorkOrder.Priority)" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefinePriorityColor(WorkOrder.Priority))">
						@WorkOrderUtility.TranslatePriority(WorkOrder.Priority)
					</MudChip>
					<MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(WorkOrderUtility.DefineStatusColor(WorkOrder.Status))">
						@WorkOrderUtility.TranslateStatus(WorkOrder.Status)
					</MudChip>
				</MudStack>
			</MudStack>
			<MudText Typo="Typo.h6"><b>@MaintObjectUtility.TranslateType(WorkOrder.MaintObjType) @WorkOrder.MaintObj</b></MudText>
		</CardHeaderContent>
	</MudCardHeader>
	<MudCardContent Class="pt-0">
		<MudText><b>Technieker: </b> @WorkOrder.Technician</MudText>
		<MudText><b>Start datum:</b> @WorkOrderUtility.ToLongStartDate(WorkOrder.StartDate)</MudText>
		<MudText><b>Eind datum:</b> @WorkOrderUtility.ToLongEndDate(WorkOrder.EndDate)</MudText>
	</MudCardContent>
</MudCard>