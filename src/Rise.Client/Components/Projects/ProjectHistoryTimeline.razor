@* Desktop view with full ValidityRange *@

<MudHidden Breakpoint="Breakpoint.Xs">
	<MudTimeline>
		<MudTimelineItem Color="Color.Primary">
			<ItemOpposite>
				<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">Huidig project</MudChip>
			</ItemOpposite>
			<ItemContent>
				<MudText Typo="Typo.h6">@Project.Code - @Project.Name</MudText>
				<MudText>Startdatum: @Project.StartDate</MudText>
				<MudText>Einddatum: @Project.EndDate</MudText>
			</ItemContent>
		</MudTimelineItem>

		@foreach (var h in Project.ProjectHistories)
		{
			<MudTimelineItem Color="Color.Primary" TimelineAlign="TimelineAlign.End">
				<ItemOpposite>
					<MudChip T="string" Variant="Variant.Outlined"
					         Color="Color.Primary">@h.ValidFrom - @h.ValidTo</MudChip>
				</ItemOpposite>

				<ItemContent>
					<MudText Typo="Typo.h6">@Project.Code - @Project.Name</MudText>
					<MudText>Startdatum: @h.StartDate</MudText>
					<MudText>Einddatum: @h.EndDate</MudText>
				</ItemContent>
			</MudTimelineItem>
		}
	</MudTimeline>
</MudHidden>

@* Mobile view with only ValidFrom *@

<MudHidden Breakpoint="Breakpoint.SmAndUp">
	<MudTimeline TimelinePosition="TimelinePosition.Left">
		<MudTimelineItem Color="Color.Primary">
			<ItemContent>
				<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">Huidig project</MudChip>
				<MudText Typo="Typo.h6">@Project.Code - @Project.Name</MudText>
				<MudText>Startdatum: @Project.StartDate</MudText>
				<MudText>Einddatum: @Project.EndDate</MudText>
			</ItemContent>
		</MudTimelineItem>

		@foreach (var h in Project.ProjectHistories)
		{
			<MudTimelineItem Color="Color.Primary">
				<ItemContent>
					<MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@h.ValidFrom</MudChip>
					<MudText Typo="Typo.h6">@Project.Code - @Project.Name</MudText>
					<MudText>Startdatum: @h.StartDate</MudText>
					<MudText>Einddatum: @h.EndDate</MudText>
				</ItemContent>
			</MudTimelineItem>
		}
	</MudTimeline>
</MudHidden>
