@page "/"

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="text-center mt-10">

	<MudText Typo="Typo.h3" GutterBottom="true">
		VMM App - Expert
	</MudText>

	<MudText Typo="Typo.subtitle1" GutterBottom="true">
		Built with MudBlazor and FastEndpoints
	</MudText>

	<MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="mt-6 mb-10">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="private-page">
			Go to Private Page
		</MudButton>
		<MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="https://github.com" Target="_blank">
			View Source
		</MudButton>
	</MudStack>

	<MudDivider Class="mb-8"/>

	<MudGrid GutterSize="3">
		<MudItem xs="12" md="4">
			<MudPaper Class="pa-4">
				<MudIcon Icon="@Icons.Material.Filled.Speed" Size="Size.Large"/>
				<MudText Typo="Typo.subtitle1">FastEndpoints API</MudText>
			</MudPaper>
		</MudItem>

		<MudItem xs="12" md="4">
			<MudPaper Class="pa-4">
				<MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Large"/>
				<MudText Typo="Typo.subtitle1">Auth & Roles</MudText>
			</MudPaper>
		</MudItem>

		<MudItem xs="12" md="4">
			<MudPaper Class="pa-4">
				<MudIcon Icon="@Icons.Material.Filled.DashboardCustomize" Size="Size.Large"/>
				<MudText Typo="Typo.subtitle1">Ready to Customize</MudText>
			</MudPaper>
		</MudItem>
	</MudGrid>
</MudContainer>