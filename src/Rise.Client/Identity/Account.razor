@page "/account"
@attribute [Authorize]

<PageTitle>Account</PageTitle>

@if (_isLoading)
{
	<MudContainer Class="mt-6">
		<MudText Typo="Typo.h6">Accountgegevens laden...</MudText>
		<MudProgressLinear Indeterminate="true" Class="mt-2"/>
	</MudContainer>
}
else
{
	<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
		<MudCard Class="p-4">
			<MudGrid Class="mb-2">
				<MudItem xs="3" sm="2">
					<MudAvatar Size="Size.Large"
					           Color="Color.Primary">
						@_initials
					</MudAvatar>
				</MudItem>

				<MudItem xs="9" sm="10">
					<MudText Typo="Typo.h5">@_email</MudText>

					@if (_roles?.Any() == true)
					{
						<div class="mt-1">
							@foreach (var role in _roles)
							{
								<MudChip T="string"
								         Variant="Variant.Filled"
								         Size="Size.Small"
								         Color="Color.Secondary"
								         Class="me-1 mb-1">
									@role
								</MudChip>
							}
						</div>
					}
				</MudItem>
			</MudGrid>

			<MudDivider Class="my-2"/>

			<MudCardActions Class="justify-end">
				<MudButton OnClick="Logout"
				           Variant="Variant.Filled"
				           Color="Color.Error">
					Uitloggen
				</MudButton>
			</MudCardActions>
		</MudCard>
	</MudContainer>
}